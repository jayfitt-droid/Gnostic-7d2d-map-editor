<Window x:Class="MapEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:map="clr-namespace:MapEditor.App.Map"
        xmlns:local="clr-namespace:MapEditor.App"
        xmlns:ops="clr-namespace:MapEditor.Core.Ops;assembly=MapEditor.Core"
        Title="{x:Static local:App.ProductName}" Width="1400" Height="900" MinWidth="1000" MinHeight="480">
    <Window.Resources>
        <!-- One labelled field in the tool options strip. -->
        <Style x:Key="OptionLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="OptionGroup" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,2,20,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Vertical slider on the left rail, like Paint's size and opacity sliders. -->
        <Style x:Key="RailSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="AutoToolTipPlacement" Value="BottomRight" />
        </Style>
        <!-- Modern theme (#63): a toolbar group, with each tool's name under its icon when the names fit. -->
        <Style x:Key="ModernToolGroup" TargetType="ListBox" BasedOn="{StaticResource ToolGroup}">
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{Binding Icon}" Style="{StaticResource IconPath}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ShortLabel}" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center"
                                       Visibility="{Binding DataContext.ToolNamesShown, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="ToolTip" Value="{Binding}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome" Width="36" Height="34" Margin="1" CornerRadius="4" Background="Transparent"
                                            BorderThickness="1" BorderBrush="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ToolNamesShown, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="Chrome" Property="Width" Value="52" />
                                            <Setter TargetName="Chrome" Property="Height" Value="50" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Modern theme (#63): a bordered button on the right of the toolbar. -->
        <Style x:Key="ModernAction" TargetType="ButtonBase" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Chrome" Height="30" Padding="10,0" CornerRadius="4" BorderThickness="1"
                                Background="{DynamicResource ButtonBackground}" BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonBackgroundPressed}" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonBackgroundDisabled}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Modern theme (#63): Export, the toolbar's one accent button. -->
        <Style x:Key="ModernExportAction" TargetType="ButtonBase" BasedOn="{StaticResource ModernAction}">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Chrome" Height="30" Padding="10,0" CornerRadius="4" Background="{DynamicResource AccentButtonBackground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentButtonBackgroundDisabled}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Modern theme (#63): the minimize, maximize and close buttons in the title bar. -->
        <Style x:Key="ModernCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <!-- Windows owns the maximize button's mouse, for its snap layouts, so the window sets this. -->
                            <Trigger Property="Tag" Value="Hover">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernCloseButton" TargetType="Button" BasedOn="{StaticResource ModernCaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B3271A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <!-- Modern theme (#63): a Generate stage, a full-width row with its chevron on the left. -->
        <Style x:Key="ModernStageExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <StackPanel>
                                <ToggleButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand" Focusable="True"
                                              FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              AutomationProperties.Name="Open or close this stage">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Row" Background="Transparent" Padding="4,9">
                                                <DockPanel>
                                                    <Path x:Name="Chevron" DockPanel.Dock="Left" Data="{x:Static local:Icons.ChevronDown}" Style="{StaticResource IconPath}"
                                                          Width="14" Height="14" StrokeThickness="2" Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="-90" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter Content="{TemplateBinding Header}" HorizontalAlignment="Stretch" />
                                </ToggleButton>
                                <ContentPresenter x:Name="Body" Margin="6,6,4,14" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Modern theme (#63): a stage's numbered circle, in the accent colour while the stage is open. -->
        <Style x:Key="ModernStageNumber" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Modern theme (#63): "Not run" on a stage, the quiet partner of the Done badge. -->
        <Style x:Key="ModernNotRunPill" TargetType="Border">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextElement.FontSize" Value="12" />
        </Style>
        <!-- Modern theme (#63): the side bar's resize edge, a dotted grip that shows a blue line while hovered or dragged. -->
        <ControlTemplate x:Key="ModernSash" TargetType="Thumb">
            <Grid Background="Transparent">
                <Border x:Name="Line" Width="2" HorizontalAlignment="Center" Visibility="Collapsed"
                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="3" Height="3" Margin="0,1.5" Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Ellipse Width="3" Height="3" Margin="0,1.5" Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Ellipse Width="3" Height="3" Margin="0,1.5" Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <!-- Modern theme (#63): one icon in the activity bar. The hidden header keeps the tab's Alt key working. -->
        <Style x:Key="ModernActivityItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ActivityItem_PreviewMouseDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Width="48" Height="48" Background="Transparent">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" Width="1" Height="1" Opacity="0"
                                              HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource IconPath}" Width="24" Height="24" />
                            <Border x:Name="ActiveBar" Width="2" HorizontalAlignment="Left" Visibility="Collapsed"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Border x:Name="CountBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,7" MinWidth="16" Height="16"
                                    Padding="3,0" CornerRadius="8" Visibility="Collapsed" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="{Binding IssueBadgeText}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="TabStripPlacement" Value="Right">
                                <Setter TargetName="ActiveBar" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Uid, RelativeSource={RelativeSource Self}}" Value="IssuesView" />
                                    <Condition Binding="{Binding HasIssueCount}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="CountBadge" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!-- Listed last so it wins: with the side bar closed, no view is showing. -->
                            <DataTrigger Binding="{Binding ShowSidePanel}" Value="False">
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Modern theme (#63): the side panel's tabs as an activity bar, with the open view beside it. -->
        <Style x:Key="ModernSideTabs" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernActivityItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border x:Name="ActivityBar" DockPanel.Dock="Left" Width="48" BorderThickness="0,0,1,0"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                            <DockPanel Visibility="{Binding ShowSidePanel, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding SideBarTitle}" Margin="20,12,12,8" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ContentPresenter ContentSource="SelectedContent" Margin="12,0,12,8" />
                            </DockPanel>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="TabStripPlacement" Value="Right">
                                <Setter TargetName="ActivityBar" Property="DockPanel.Dock" Value="Right" />
                                <Setter TargetName="ActivityBar" Property="BorderThickness" Value="1,0,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.NewWorldCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:MainWindow.OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:MainWindow.SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.SaveAsCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{x:Static local:MainWindow.ExportCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{x:Static local:MainWindow.CloseWorldCommand}" />
        <KeyBinding Key="F7" Command="{x:Static local:MainWindow.ValidateCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FindCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static local:MainWindow.UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static local:MainWindow.RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.RedoCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.NewWorldCommand}" Executed="NewWorld_Executed" CanExecute="CanOpen_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.OpenCommand}" Executed="Open_Executed" CanExecute="CanOpen_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.OpenWorldCommand}" Executed="OpenWorld_Executed" CanExecute="CanOpen_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.SaveCommand}" Executed="Save_Executed" CanExecute="HasWorld_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCommand}" Executed="SaveAs_Executed" CanExecute="HasWorld_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.ExportCommand}" Executed="Export_Executed" CanExecute="HasWorld_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.CloseWorldCommand}" Executed="CloseWorld_Executed" CanExecute="HasWorld_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.ValidateCommand}" Executed="Validate_Executed" CanExecute="HasWorld_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.GenerateCommand}" Executed="Generate_Executed" CanExecute="HasWorld_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.PackageCommand}" Executed="Package_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.FindCommand}" Executed="Find_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.UndoCommand}" Executed="Undo_Executed" CanExecute="Undo_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.RedoCommand}" Executed="Redo_Executed" CanExecute="Redo_CanExecute" />
    </Window.CommandBindings>

    <DockPanel x:Name="RootDock">
        <!-- Menus and the quick-access icons, as on Paint's top row. -->
        <DockPanel x:Name="TitleRow" DockPanel.Dock="Top">
        <!-- Modern theme (#63): the layout buttons and the window's own buttons, at the right of the title bar. -->
        <StackPanel x:Name="WindowControls" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding IsModernTheme, Converter={StaticResource BoolToVisibility}}">
            <ToggleButton Style="{StaticResource FlatButton}" Width="32" Height="28" Padding="0" Margin="2,4" IsChecked="{Binding ShowSidePanel}"
                          ToolTip="Show or hide the side bar" AutomationProperties.Name="Side bar">
                <Path Width="16" Height="16">
                    <Path.Style>
                        <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                            <Setter Property="Data" Value="{x:Static local:Icons.PanelLeft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SideBarOnRight}" Value="True">
                                    <Setter Property="Data" Value="{x:Static local:Icons.PanelRight}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </ToggleButton>
            <Grid Margin="2,4,10,4">
                <ToggleButton x:Name="LayoutButton" Style="{StaticResource FlatButton}" Width="32" Height="28" Padding="0"
                              ToolTip="Choose the layout" AutomationProperties.Name="Layout">
                    <Path Data="{x:Static local:Icons.LayoutOptions}" Style="{StaticResource IconPath}" Width="16" Height="16" />
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=LayoutButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=LayoutButton}"
                       Placement="Bottom" AllowsTransparency="True" Closed="LayoutPopup_Closed">
                    <Border Padding="14,10" CornerRadius="6" BorderThickness="1" Margin="0,4,0,0"
                            Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
                        <StackPanel>
                            <CheckBox Content="Side bar on the right" IsChecked="{Binding SideBarOnRight}" Margin="0,3" />
                            <CheckBox Content="Tool options" IsChecked="{Binding ShowToolOptions}" Margin="0,3" />
                            <CheckBox Content="Mini map" IsChecked="{Binding ShowMiniMap}" Margin="0,3" />
                            <Separator Margin="0,6" />
                            <TextBlock Text="Tool names" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <RadioButton Content="Automatic" GroupName="ToolNames" IsChecked="{Binding RibbonAuto}" Margin="0,3" />
                            <RadioButton Content="Always show" GroupName="ToolNames" IsChecked="{Binding RibbonFull}" Margin="0,3" />
                            <RadioButton Content="Never show" GroupName="ToolNames" IsChecked="{Binding RibbonCompact}" Margin="0,3" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            <Button Style="{StaticResource ModernCaptionButton}" Click="WindowMinimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                <TextBlock Text="&#xE921;" Style="{StaticResource CaptionGlyph}" />
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource ModernCaptionButton}" Click="WindowMaximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" Style="{StaticResource CaptionGlyph}" />
            </Button>
            <Button Style="{StaticResource ModernCloseButton}" Click="WindowClose_Click" ToolTip="Close" AutomationProperties.Name="Close">
                <TextBlock Text="&#xE8BB;" Style="{StaticResource CaptionGlyph}" />
            </Button>
        </StackPanel>
        <StackPanel x:Name="MenuRow" DockPanel.Dock="Left" Orientation="Horizontal" Margin="4,2,4,0">
            <Image Source="pack://application:,,,/app.ico" Width="16" Height="16" Margin="6,0,4,0" VerticalAlignment="Center"
                   Visibility="{Binding IsModernTheme, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Gnostic" />
            <Menu x:Name="MainMenu" Background="Transparent" VerticalAlignment="Center" IsEnabled="{Binding IsWorldMode}">
                <MenuItem Header="_File" SubmenuOpened="FileMenu_SubmenuOpened">
                    <MenuItem Header="_New World..." InputGestureText="Ctrl+N" Command="{x:Static local:MainWindow.NewWorldCommand}" />
                    <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{x:Static local:MainWindow.OpenCommand}"
                              ToolTip="Open a project (.7dmap), or a world's dtm.raw or map_info.xml" />
                    <MenuItem Header="Open World _Folder..." Command="{x:Static local:MainWindow.OpenWorldCommand}" />
                    <MenuItem Header="Open _Recent" x:Name="RecentMenu" />
                    <Separator />
                    <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{x:Static local:MainWindow.SaveCommand}" />
                    <MenuItem Header="Save Project _As..." InputGestureText="Ctrl+Shift+S" Command="{x:Static local:MainWindow.SaveAsCommand}" />
                    <MenuItem Header="_Export World..." InputGestureText="Ctrl+E" Command="{x:Static local:MainWindow.ExportCommand}" />
                    <MenuItem Header="_Close" InputGestureText="Ctrl+W" Command="{x:Static local:MainWindow.CloseWorldCommand}" />
                    <Separator />
                    <MenuItem Header="_Import Heightmap..." Click="ImportHeightmap_Click" />
                    <MenuItem Header="Export _Heightmap..." Click="ExportHeightmap_Click" />
                    <MenuItem Header="Export _Map Image..." Click="ExportMapImage_Click" />
                    <Separator />
                    <MenuItem Header="E_xit" Click="Exit_Click" />
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="{Binding UndoText}" InputGestureText="Ctrl+Z" Command="{x:Static local:MainWindow.UndoCommand}" />
                    <MenuItem Header="{Binding RedoText}" InputGestureText="Ctrl+Y" Command="{x:Static local:MainWindow.RedoCommand}" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="_Fit to Window" InputGestureText="Home" Click="Fit_Click" />
                    <MenuItem Header="Zoom _In" InputGestureText="+" Click="ZoomIn_Click" />
                    <MenuItem Header="Zoom _Out" InputGestureText="-" Click="ZoomOut_Click" />
                    <Separator />
                    <MenuItem Header="_Ribbon">
                        <MenuItem Header="_Automatic" IsCheckable="True" IsChecked="{Binding RibbonAuto}"
                                  ToolTip="Compact while the window is short, full otherwise" />
                        <MenuItem Header="_Full" IsCheckable="True" IsChecked="{Binding RibbonFull}" />
                        <MenuItem Header="_Compact" IsCheckable="True" IsChecked="{Binding RibbonCompact}"
                                  ToolTip="One row of icons; hover a tool for its name and how to use it" />
                    </MenuItem>
                    <MenuItem Header="_Tool Options" IsCheckable="True" IsChecked="{Binding ShowToolOptions}" />
                    <MenuItem Header="_Mini Map" IsCheckable="True" IsChecked="{Binding ShowMiniMap}" />
                    <MenuItem Header="_Side Panel" IsCheckable="True" IsChecked="{Binding ShowSidePanel}" />
                    <MenuItem Header="Side Bar on the Ri_ght" IsCheckable="True" IsChecked="{Binding SideBarOnRight}"
                              Visibility="{Binding IsModernTheme, Converter={StaticResource BoolToVisibility}}" />
                    <MenuItem Header="_World Info" Click="WorldInfo_Click" />
                </MenuItem>
                <MenuItem Header="_World">
                    <MenuItem Header="_Generate..." Command="{x:Static local:MainWindow.GenerateCommand}" />
                    <MenuItem Header="_Validate" InputGestureText="F7" Command="{x:Static local:MainWindow.ValidateCommand}" />
                    <MenuItem Header="_Export World..." InputGestureText="Ctrl+E" Command="{x:Static local:MainWindow.ExportCommand}" />
                    <MenuItem Header="_Package Maps..." Command="{x:Static local:MainWindow.PackageCommand}" />
                </MenuItem>
                <MenuItem Header="_Settings">
                    <MenuItem Header="_Game Folder..." Click="GameFolder_Click" />
                    <MenuItem Header="_Autosave Every 5 Minutes" IsCheckable="True" IsChecked="{Binding Autosave}" />
                    <MenuItem Header="_Theme">
                        <MenuItem x:Name="ThemeFlatItem" Header="_Flat" Tag="Flat" IsCheckable="True" Click="Theme_Click" />
                        <MenuItem x:Name="ThemeModernItem" Header="_Modern" Tag="Modern" IsCheckable="True" Click="Theme_Click" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="_Keyboard Shortcuts" InputGestureText="F1" Click="Shortcuts_Click" />
                    <MenuItem Header="Check for _Updates..." Click="CheckUpdates_Click" />
                    <MenuItem Header="_About" Click="About_Click" />
                </MenuItem>
            </Menu>
            <Border Style="{StaticResource RibbonDivider}" Margin="6,8" />
            <Button Style="{StaticResource FlatButton}" Command="{x:Static local:MainWindow.SaveCommand}" ToolTip="Save (Ctrl+S)"
                    Visibility="{Binding IsWorldMode, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Save">
                <Path Data="{x:Static local:Icons.Save}" Style="{StaticResource IconPath}" Width="16" Height="16" />
            </Button>
            <Button Style="{StaticResource FlatButton}" Command="{x:Static local:MainWindow.UndoCommand}" ToolTip="{Binding UndoText}"
                    AutomationProperties.Name="Undo">
                <Path Data="{x:Static local:Icons.Undo}" Style="{StaticResource IconPath}" Width="16" Height="16" />
            </Button>
            <Button Style="{StaticResource FlatButton}" Command="{x:Static local:MainWindow.RedoCommand}" ToolTip="{Binding RedoText}"
                    AutomationProperties.Name="Redo">
                <Path Data="{x:Static local:Icons.Redo}" Style="{StaticResource IconPath}" Width="16" Height="16" />
            </Button>
        </StackPanel>
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding IsModernTheme, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>

        <Border DockPanel.Dock="Top" Padding="12,6" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Visibility="{Binding IsLandMode, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ProgressBar Width="100" Height="6" Margin="0,0,10,0" Maximum="1" Value="{Binding Generate.Progress}"
                                 Visibility="{Binding Generate.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Build World" Style="{DynamicResource AccentButtonStyle}" IsEnabled="{Binding CanBuildLand}" Click="BuildLand_Click" />
                    <Button Content="Cancel" Margin="6,0,0,0" Click="CancelLand_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Land mode" FontWeight="SemiBold" FontSize="15" Margin="0,0,20,0" VerticalAlignment="Center" />
                    <StackPanel x:Name="LandTools" Orientation="Horizontal"
                                IsEnabled="{Binding DataContext.CanBuildLand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <RadioButton Content="Rectangle" GroupName="LandTools" IsChecked="{Binding RectangleTool}" Margin="0,0,12,0" />
                        <RadioButton Content="Select boxes" GroupName="LandTools" IsChecked="{Binding SelectTool}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The ribbon: tool groups with their names underneath. -->
        <Border DockPanel.Dock="Top" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Visibility="{Binding IsWorldMode, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Padding" Value="10,6,10,4" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompactRibbon}" Value="True">
                            <Setter Property="Padding" Value="10,3" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel x:Name="RibbonDock">
                <ToggleButton x:Name="ToolOptionsToggle" DockPanel.Dock="Right" VerticalAlignment="Bottom" Style="{StaticResource FlatButton}" Padding="4"
                              IsChecked="{Binding ShowToolOptions}" ToolTip="Show or hide the tool options"
                              AutomationProperties.Name="Tool options">
                    <Path Data="{x:Static local:Icons.ChevronDown}" Style="{StaticResource IconPath}" Width="12" Height="12" />
                </ToggleButton>
                <StackPanel x:Name="RibbonTools" Orientation="Horizontal">
                    <StackPanel>
                        <ListBox x:Name="NavigateGroup" Style="{StaticResource ToolGroup}" ItemsSource="{Binding NavigateTools}" SelectedValue="{Binding SelectedTool}"
                                 AutomationProperties.Name="Navigate" Height="{Binding RibbonRowHeight}" VerticalContentAlignment="Top">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Top" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <TextBlock Text="Navigate" Style="{StaticResource RibbonLabel}" />
                    </StackPanel>
                    <Border Style="{StaticResource RibbonDivider}" />
                    <StackPanel>
                        <ListBox x:Name="TerrainGroup" Style="{StaticResource ToolGroup}" ItemsSource="{Binding TerrainTools}" SelectedValue="{Binding SelectedTool}"
                                 AutomationProperties.Name="Terrain tools">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="{Binding TerrainColumns}" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <TextBlock Text="Terrain" Style="{StaticResource RibbonLabel}" />
                    </StackPanel>
                    <Border Style="{StaticResource RibbonDivider}" />
                    <StackPanel>
                        <ListBox x:Name="PaintGroup" Style="{StaticResource ToolGroup}" ItemsSource="{Binding PaintTools}" SelectedValue="{Binding SelectedTool}"
                                 AutomationProperties.Name="Paint tools">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="{Binding PaintColumns}" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <TextBlock Text="Paint" Style="{StaticResource RibbonLabel}" />
                    </StackPanel>
                    <Border Style="{StaticResource RibbonDivider}" />
                    <StackPanel>
                        <ListBox x:Name="BuildGroup" Style="{StaticResource ToolGroup}" ItemsSource="{Binding BuildTools}" SelectedValue="{Binding SelectedTool}"
                                 AutomationProperties.Name="Build tools">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="{Binding BuildColumns}" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <TextBlock Text="Build" Style="{StaticResource RibbonLabel}" />
                    </StackPanel>
                    <Border x:Name="BuildDivider" Style="{StaticResource RibbonDivider}" />

                    <!-- Palette: the current biome or road surface, then every biome and both road surfaces. -->
                    <StackPanel x:Name="PaletteGroup">
                        <StackPanel Orientation="Horizontal" Height="{Binding RibbonRowHeight}">
                            <Grid Width="{Binding CurrentSwatchSize}" Height="{Binding CurrentSwatchSize}" Margin="2,0,8,0" VerticalAlignment="Top"
                                  ToolTip="{Binding CurrentSwatch.Label}">
                                <Ellipse Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2" />
                                <Ellipse Margin="4" Fill="{Binding CurrentSwatch.Color, Converter={StaticResource RgbToBrush}}"
                                         Stroke="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Grid>
                            <StackPanel Orientation="{Binding PaletteOrientation}">
                                <ItemsControl ItemsSource="{Binding BiomeChoices}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButton}" Background="{Binding Color, Converter={StaticResource RgbToBrush}}"
                                                    ToolTip="{Binding Name, Converter={x:Static local:FriendlyNameConverter.Biome}, StringFormat=Paint {0}}"
                                                    AutomationProperties.Name="{Binding Name, Converter={x:Static local:FriendlyNameConverter.Biome}}"
                                                    Tag="{Binding}" Click="BiomeSwatch_Click" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding RoadSwatches}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButton}" Background="{Binding Color, Converter={StaticResource RgbToBrush}}"
                                                    ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                                    Tag="{Binding}" Click="RoadSwatch_Click" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Palette" Style="{StaticResource RibbonLabel}" />
                    </StackPanel>
                    <Border x:Name="PaletteDivider" Style="{StaticResource RibbonDivider}" />

                    <!-- Layers: a drop-down of what the map shows. -->
                    <StackPanel x:Name="LayersGroup">
                        <Grid Height="{Binding RibbonRowHeight}">
                            <ToggleButton x:Name="LayersButton" Style="{StaticResource RibbonAction}"
                                          ToolTip="Choose what the map shows" AutomationProperties.Name="Layers">
                                <Path Data="{x:Static local:Icons.Layers}" Style="{StaticResource IconPath}" Width="24" Height="24" />
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=LayersButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=LayersButton}"
                                   Placement="Bottom" AllowsTransparency="True" Closed="LayersPopup_Closed">
                                <Border Padding="14,10" CornerRadius="6" BorderThickness="1" Margin="0,4,0,0"
                                        Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                        BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
                                    <StackPanel>
                                        <CheckBox Content="_Hillshade" IsChecked="{Binding ShowHillshade}" Margin="0,3" />
                                        <CheckBox Content="_Biomes" IsChecked="{Binding ShowBiomes}" Margin="0,3" />
                                        <CheckBox Content="_Water" IsChecked="{Binding ShowWater}" Margin="0,3" />
                                        <CheckBox Content="_Roads" IsChecked="{Binding ShowRoads}" Margin="0,3" />
                                        <CheckBox Content="R_adiation" IsChecked="{Binding ShowRadiation}" Margin="0,3" />
                                        <CheckBox Content="_Prefabs (POIs)" IsChecked="{Binding ShowPrefabs}" Margin="0,3" />
                                        <CheckBox Content="Prefab de_tail when zoomed in" IsChecked="{Binding ShowPrefabDetail}" Margin="22,3,0,3"
                                                  IsEnabled="{Binding ShowPrefabs}" ToolTip="Draw street tiles and POIs from above: roads, pavements and buildings" />
                                        <CheckBox Content="_Spawn points" IsChecked="{Binding ShowSpawns}" Margin="0,3" />
                                        <CheckBox Content="World _grid (150 m, where towns snap)" IsChecked="{Binding ShowWorldGrid}" Margin="0,3"
                                                  ToolTip="The world's 150 m street-tile grid. Town sites and the Town tool put towns on it. Shows once you zoom in far enough." />
                                        <Separator Margin="0,6" />
                                        <CheckBox Content="_Dim the map (prefabs stand out)" IsChecked="{Binding DimMap}" Margin="0,3" />
                                        <Separator Margin="0,6" />
                                        <CheckBox x:Name="ShowPlayerCheck" Content="Show player" IsChecked="{Binding ShowPlayer}"
                                                  IsEnabled="False" Margin="0,3" ToolTip="Show your live position and facing with Gnostic Game Link" />
                                        <CheckBox Content="Follow" IsChecked="{Binding FollowPlayer}" IsEnabled="{Binding ShowPlayer}"
                                                  Margin="22,3,0,3" AutomationProperties.Name="Follow player"
                                                  ToolTip="Keep the player in view. Moving or zooming the map turns Follow off." />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <TextBlock Text="Layers" Style="{StaticResource RibbonLabel}" />
                    </StackPanel>
                    <Border x:Name="LayersDivider" Style="{StaticResource RibbonDivider}" />

                    <StackPanel x:Name="WorldGroup">
                        <StackPanel Orientation="Horizontal" Height="{Binding RibbonRowHeight}">
                            <Button x:Name="GenerateAction" Style="{StaticResource RibbonAction}" Command="{x:Static local:MainWindow.GenerateCommand}"
                                    ToolTip="Generate: make terrain and more the way the game's generator does" AutomationProperties.Name="Generate">
                                <StackPanel>
                                    <Path Data="{x:Static local:Icons.Generate}" Style="{StaticResource IconPath}" Width="24" Height="24" />
                                    <TextBlock Text="Generate" Style="{StaticResource RibbonButtonText}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ValidateAction" Style="{StaticResource RibbonAction}" Command="{x:Static local:MainWindow.ValidateCommand}"
                                    ToolTip="Validate: check the world for problems (F7)" AutomationProperties.Name="Validate">
                                <StackPanel>
                                    <Path Data="{x:Static local:Icons.Validate}" Style="{StaticResource IconPath}" Width="24" Height="24" />
                                    <TextBlock Text="Validate" Style="{StaticResource RibbonButtonText}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ExportAction" Style="{StaticResource RibbonAction}" Command="{x:Static local:MainWindow.ExportCommand}"
                                    ToolTip="Export: write a world folder the game can load (Ctrl+E)" AutomationProperties.Name="Export">
                                <StackPanel>
                                    <Path Data="{x:Static local:Icons.Export}" Style="{StaticResource IconPath}" Width="24" Height="24" />
                                    <TextBlock Text="Export" Style="{StaticResource RibbonButtonText}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PackageAction" Style="{StaticResource RibbonAction}" Command="{x:Static local:MainWindow.PackageCommand}"
                                    ToolTip="Package maps: zip exported maps and their custom prefabs as a mod" AutomationProperties.Name="Package maps">
                                <StackPanel>
                                    <Path Data="{x:Static local:Icons.Package}" Style="{StaticResource IconPath}" Width="24" Height="24" />
                                    <TextBlock Text="Package" Style="{StaticResource RibbonButtonText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="World" Style="{StaticResource RibbonLabel}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Options for the active tool, in one strip under the ribbon. -->
        <Border DockPanel.Dock="Top" Padding="12,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Visibility="{Binding WorldOptionsVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,20,0">
                    <Path Data="{Binding CurrentTool.Icon}" Style="{StaticResource IconPath}" Width="16" Height="16"
                          Stroke="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding CurrentTool.Label}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel>
                    <WrapPanel>
                        <!-- Modern theme (#63): brush size and strength, the palette's swatches and a short hint, in this row. -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsModernTheme, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding HasSize, Converter={StaticResource BoolToVisibility}}" ToolTip="Size ([ and ])">
                                <TextBlock Text="Size" Style="{StaticResource OptionLabel}" />
                                <Slider Minimum="{Binding SizeMin}" Maximum="{Binding SizeMax}" Value="{Binding SizeValue}" Width="120" VerticalAlignment="Center"
                                        AutomationProperties.Name="Brush size" />
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource OptionLabel}" Margin="8,0,0,0" MinWidth="72" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding HasStrength, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Strength" Style="{StaticResource OptionLabel}" />
                                <Slider Minimum="{Binding StrengthMin}" Maximum="1" Value="{Binding StrengthValue}" Width="120" VerticalAlignment="Center"
                                        AutomationProperties.Name="Brush strength" />
                                <TextBlock Text="{Binding StrengthText}" Style="{StaticResource OptionLabel}" Margin="8,0,0,0" MinWidth="40" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding BiomeChoices}" Focusable="False" Margin="0,0,20,0" VerticalAlignment="Center"
                                          Visibility="{Binding IsBiomeTool, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SwatchButton}" Background="{Binding Color, Converter={StaticResource RgbToBrush}}"
                                                ToolTip="{Binding Name, Converter={x:Static local:FriendlyNameConverter.Biome}, StringFormat=Paint {0}}"
                                                AutomationProperties.Name="{Binding Name, Converter={x:Static local:FriendlyNameConverter.Biome}}"
                                                Tag="{Binding}" Click="BiomeSwatch_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding RoadSwatches}" Focusable="False" Margin="0,0,20,0" VerticalAlignment="Center"
                                          Visibility="{Binding IsRoadTool, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SwatchButton}" Background="{Binding Color, Converter={StaticResource RgbToBrush}}"
                                                ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                                Tag="{Binding}" Click="RoadSwatch_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding CurrentTool.Hint}" ToolTip="{Binding CurrentTool.Hint}" Style="{StaticResource HintText}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" MaxWidth="{Binding InlineHintMaxWidth}" VerticalAlignment="Center"
                                       Visibility="{Binding ShowInlineToolHint, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <!-- Brush shape, for the terrain and paint brushes and the road eraser. -->
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding HasRadius, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Shape" Style="{StaticResource OptionLabel}" />
                            <ComboBox ItemsSource="{Binding BrushShapes}" SelectedItem="{Binding BrushShape}" MinWidth="100" AutomationProperties.Name="Brush shape" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding IsSquareBrush, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding BrushRotation, StringFormat=Rotation {0:0}°  (Q / E)}" Style="{StaticResource OptionLabel}" />
                            <Slider Minimum="0" Maximum="359" Value="{Binding BrushRotation}" Width="120" AutomationProperties.Name="Brush rotation" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding IsBrushTool, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Edge" Style="{StaticResource OptionLabel}" />
                            <ComboBox ItemsSource="{Binding BrushFalloffs}" SelectedItem="{Binding BrushFalloff}" MinWidth="100" AutomationProperties.Name="Brush edge" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding IsFlattenTool, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Target height (m)" Style="{StaticResource OptionLabel}" />
                            <TextBox Text="{Binding FlattenHeight, UpdateSourceTrigger=PropertyChanged, StringFormat=0.0}" Width="70"
                                     AutomationProperties.Name="Target height" />
                            <CheckBox Content="Lock height" IsChecked="{Binding FlattenLocked}" Margin="12,0,0,0"
                                      ToolTip="Otherwise the height is picked where each stroke starts" />
                            <CheckBox Content="Whole metres" IsChecked="{Binding FlattenWholeMetres}" Margin="12,0,0,0"
                                      ToolTip="Round the height picked from the map to a whole metre, the height prefabs and levelled roads sit at" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding IsNoiseTool, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding NoiseScale, StringFormat=Feature size {0:0} m}" Style="{StaticResource OptionLabel}" />
                            <Slider Minimum="4" Maximum="400" Value="{Binding NoiseScale}" Width="140" AutomationProperties.Name="Feature size" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding IsStampTool, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Stamp" Style="{StaticResource OptionLabel}" />
                            <ComboBox ItemsSource="{Binding StampNames}" SelectedItem="{Binding SelectedStamp}" MinWidth="180" AutomationProperties.Name="Stamp" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding IsStampTool, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding StampRotation, StringFormat=Rotation {0:0}°  (Q / E)}" Style="{StaticResource OptionLabel}" />
                            <Slider Minimum="0" Maximum="359" Value="{Binding StampRotation}" Width="120" AutomationProperties.Name="Stamp rotation" />
                            <CheckBox Content="Additive" IsChecked="{Binding StampAdditive}" Margin="16,0,0,0" ToolTip="Add height instead of blending" />
                            <CheckBox Content="Fill water" IsChecked="{Binding StampWater}"
                                      Visibility="{Binding ShowStampWaterOption, Converter={StaticResource BoolToVisibility}}"
                                      ToolTip="Fill the stamp's low ground with water at 30 m (lake, river and water stamps always do)" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding IsBiomeTool, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Biome" Style="{StaticResource OptionLabel}" />
                            <ComboBox ItemsSource="{Binding BiomeChoices}" SelectedItem="{Binding SelectedBiome}" MinWidth="150" AutomationProperties.Name="Biome">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" Stroke="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                                     Fill="{Binding Color, Converter={StaticResource RgbToBrush}}" />
                                            <TextBlock Text="{Binding Name, Converter={x:Static local:FriendlyNameConverter.Biome}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding IsWaterTool, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding WaterLevel, StringFormat=Water level {0:0} m}" Style="{StaticResource OptionLabel}" />
                            <Slider Minimum="1" Maximum="255" Value="{Binding WaterLevel}" IsSnapToTickEnabled="True" TickFrequency="1" Width="180"
                                    AutomationProperties.Name="Water level" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding IsRoadTool, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Preset" Style="{StaticResource OptionLabel}" />
                            <ComboBox ItemsSource="{Binding RoadPresets}" SelectedItem="{Binding SelectedRoadPreset}" MinWidth="170" Margin="0,0,16,0"
                                      AutomationProperties.Name="Road preset"
                                      ToolTip="Common road sizes. Highway and Country road are RWG's own; the size slider still sets any width." />
                            <TextBlock Text="Surface" Style="{StaticResource OptionLabel}" />
                            <ComboBox ItemsSource="{Binding RoadTypes}" SelectedItem="{Binding RoadType}" MinWidth="100" AutomationProperties.Name="Road surface" />
                            <CheckBox Content="Grade the terrain under the road" IsChecked="{Binding RoadGrade}" Margin="16,0,0,0" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding IsBridgeTool, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Deck height" Style="{StaticResource OptionLabel}" />
                            <TextBox Text="{Binding BridgeDeck, UpdateSourceTrigger=LostFocus, StringFormat=0}" Width="60" IsEnabled="{Binding HasBridge}"
                                     KeyDown="BridgeDeck_KeyDown" AutomationProperties.Name="Deck height in metres"
                                     ToolTip="The road level of the deck, in metres. Over water it clears the sea by 5 m; over land it matches the higher end's ground. Change it before building, or to rebuild a selected bridge at a new height." />
                            <TextBlock Text="m" Style="{StaticResource OptionLabel}" Margin="4,0,16,0" />
                            <Button Content="Build  (Enter)" Style="{DynamicResource AccentButtonStyle}" Click="BridgeBuild_Click" />
                            <Button Content="Cancel  (Esc)" Margin="6,0,0,0" Click="BridgeCancel_Click" />
                            <Button Content="Delete  (Del)" Margin="6,0,0,0" Click="BridgeDelete_Click" />
                            <CheckBox Content="Car wrecks" IsChecked="{Binding BridgeWrecks}" Margin="6,0,0,0"
                                      ToolTip="Stand a car wreck on the deck about every 100 to 150 m of bridges you build, move, resize or rebuild. Turn off for bare decks." />
                            <Button Content="Rebuild all" Margin="10,0,16,0" Click="BridgeRebuildAll_Click"
                                    ToolTip="Build every bridge you drew again in place, with the current ramp and deck height rules (one undo step)" />
                            <TextBlock Text="{Binding BridgeText}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding IsTraderTool, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Trader" Style="{StaticResource OptionLabel}" />
                            <ComboBox ItemsSource="{Binding Traders}" SelectedItem="{Binding SelectedTrader}" MinWidth="140"
                                      AutomationProperties.Name="Trader">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static local:FriendlyNameConverter.Poi}}" ToolTip="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Random" Margin="4,0,16,0" Click="TraderRandom_Click" ToolTip="Pick another trader at random" />
                            <CheckBox Content="Flatten the ground under it" IsChecked="{Binding PrefabFlatten}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding IsPrefabsTool, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="Flatten the ground under it" IsChecked="{Binding PrefabFlatten}" />
                            <CheckBox Content="Add street furniture to street tiles" IsChecked="{Binding PrefabAddParts}" />
                            <Button Content="Prefab browser" Click="ShowPrefabBrowser_Click" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding IsTownTool, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Township" Style="{StaticResource OptionLabel}" />
                            <ComboBox ItemsSource="{Binding Townships}" SelectedItem="{Binding SelectedTownship}" MinWidth="160"
                                      AutomationProperties.Name="Township">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static local:FriendlyNameConverter.Township}}" ToolTip="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Seed" Style="{StaticResource OptionLabel}" Margin="16,0,8,0" />
                            <TextBox Text="{Binding TownSeed, UpdateSourceTrigger=LostFocus}" Width="80" AutomationProperties.Name="Seed" />
                            <Button Content="Reroll" Margin="4,0,0,0" Click="TownReroll_Click" ToolTip="Plan again with a new seed" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OptionGroup}" Visibility="{Binding IsTownTool, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="Replace prefabs in the way" IsChecked="{Binding TownReplace}" />
                            <CheckBox Content="Join exits to the nearest road" IsChecked="{Binding TownRoads}" />
                            <TextBlock Text="Match" Style="{StaticResource OptionLabel}" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding TownLinkStyle}" IsEnabled="{Binding TownRoads}" Margin="0,0,16,0"
                                      AutomationProperties.Name="Link roads match"
                                      ToolTip="Whose surface and width the joining roads take">
                                <ComboBoxItem Content="The road they join" Tag="{x:Static ops:LinkRoadStyle.JoinedRoad}" />
                                <ComboBoxItem Content="The town's streets" Tag="{x:Static ops:LinkRoadStyle.Tile}" />
                            </ComboBox>
                            <CheckBox Content="Street furniture and props" IsChecked="{Binding TownParts}" />
                            <TextBlock Text="Traders" Style="{StaticResource OptionLabel}" />
                            <ComboBox ItemsSource="{Binding TraderCounts}" SelectedItem="{Binding TownTraders}" MinWidth="60" Margin="0,0,16,0"
                                      AutomationProperties.Name="Traders"
                                      ToolTip="How many traders the town gets, as long as enough lots are big enough. The first goes nearest the middle, the rest spread apart." />
                            <Button Content="Build  (Enter)" Style="{DynamicResource AccentButtonStyle}" IsEnabled="{Binding HasTownPlan}" Click="TownBuild_Click" />
                            <Button Content="Cancel  (Esc)" Margin="6,0,0,0" Click="TownCancel_Click" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- One of these at a time, over an invisible six lines that hold the strip's height while the text changes. -->
                    <Grid x:Name="ToolHintLines">
                        <TextBlock Text="{Binding ReservedInfoText}" Style="{StaticResource HintText}" Margin="0,4,0,0" Opacity="0" IsHitTestVisible="False"
                                   Visibility="{Binding ReservesInfoLines, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding TownText}" Style="{StaticResource HintText}" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Visibility="{Binding IsTownTool, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding PlacementText}" Style="{StaticResource HintText}" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Visibility="{Binding IsPrefabTool, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding SelectionText}" Style="{StaticResource HintText}" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Visibility="{Binding ShowSelectionText, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock x:Name="ToolHintLine" Text="{Binding CurrentTool.Hint}" Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Visibility="{Binding ShowToolHint, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar, as in Paint: cursor, selection, world size, then messages and zoom on the right. -->
        <Border DockPanel.Dock="Bottom" Padding="8,2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Width="24" Margin="0,0,8,0" Background="Transparent" ToolTip="{Binding GameLinkConnectionText}"
                            AutomationProperties.Name="{Binding GameLinkConnectionText}"
                            Visibility="{Binding GameLinkInstalled, Converter={StaticResource BoolToVisibility}}">
                        <Path Data="{x:Static local:Icons.GameLink}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameLinkConnected}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Border>
                    <ProgressBar IsIndeterminate="True" Width="80" Margin="0,0,12,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource FlatButton}" Click="Fit_Click" ToolTip="Fit to window (Home)" AutomationProperties.Name="Fit to window">
                        <Path Data="{x:Static local:Icons.Fit}" Style="{StaticResource IconPath}" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="ZoomMenuButton" Style="{StaticResource FlatButton}" Click="ZoomMenu_Click" MinWidth="64" Padding="8,4"
                            ToolTip="Choose a zoom level" AutomationProperties.Name="Zoom level">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ZoomPercentText}" VerticalAlignment="Center" />
                            <Path Data="{x:Static local:Icons.ChevronDown}" Style="{StaticResource IconPath}" Width="10" Height="10" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="ZoomOut_Click" ToolTip="Zoom out (-)" AutomationProperties.Name="Zoom out">
                        <Path Data="{x:Static local:Icons.ZoomOut}" Style="{StaticResource IconPath}" Width="16" Height="16" />
                    </Button>
                    <Slider x:Name="ZoomSlider" Width="140" VerticalAlignment="Center" Minimum="-8" Maximum="4" SmallChange="0.25" LargeChange="1"
                            Value="{Binding ZoomLog}" ValueChanged="ZoomSlider_ValueChanged" AutomationProperties.Name="Zoom" />
                    <Button Style="{StaticResource FlatButton}" Click="ZoomIn_Click" ToolTip="Zoom in (+)" AutomationProperties.Name="Zoom in">
                        <Path Data="{x:Static local:Icons.ZoomIn}" Style="{StaticResource IconPath}" Width="16" Height="16" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" TextElement.FontSize="12">
                    <!-- Modern theme (#63): the error and warning counts; a click opens the Issues view. -->
                    <Button Style="{StaticResource FlatButton}" Padding="6,2" Margin="0,0,10,0" Click="IssueCounter_Click" ToolTip="{Binding IssuesText}"
                            AutomationProperties.Name="Show issues" AutomationProperties.HelpText="{Binding IssuesText}"
                            Visibility="{Binding IsModernTheme, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{x:Static local:Icons.IssueError}" Width="14" Height="14">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                        <Setter Property="Stroke" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ErrorCount}" Value="0">
                                                <Setter Property="Stroke" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding ErrorCount}" Margin="4,0,10,0" VerticalAlignment="Center" />
                            <Path Data="{x:Static local:Icons.ActivityIssues}" Width="14" Height="14">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                        <Setter Property="Stroke" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WarningCount}" Value="0">
                                                <Setter Property="Stroke" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding WarningCount}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Path Data="{x:Static local:Icons.Cursor}" Style="{StaticResource IconPath}" Width="14" Height="14"
                          Stroke="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding CursorText}" Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="280" />
                    <Border Style="{StaticResource RibbonDivider}" Margin="10,4" />
                    <Path Data="{x:Static local:Icons.Selection}" Style="{StaticResource IconPath}" Width="14" Height="14"
                          Stroke="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding SelectionSizeText}" Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="90" />
                    <Border Style="{StaticResource RibbonDivider}" Margin="10,4" />
                    <Path Data="{x:Static local:Icons.WorldSize}" Style="{StaticResource IconPath}" Width="14" Height="14"
                          Stroke="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding WorldSizeText}" Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="110" />
                    <Border Style="{StaticResource RibbonDivider}" Margin="10,4" />
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding Status}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Left rail: brush size and strength, like Paint's size and opacity sliders. -->
        <Border x:Name="LeftRail" DockPanel.Dock="Left" Width="56" Padding="0,10" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Visibility="{Binding IsWorldMode, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Visibility="{Binding HasSize, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10" ToolTip="Size ([ and ])">
                    <Path DockPanel.Dock="Top" Data="{x:Static local:Icons.Size}" Style="{StaticResource IconPath}" Width="16" Height="16"
                          Stroke="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SizeText}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Slider Style="{StaticResource RailSlider}" Minimum="{Binding SizeMin}" Maximum="{Binding SizeMax}" Value="{Binding SizeValue}"
                            AutoToolTipPrecision="0" AutomationProperties.Name="Brush size" />
                </DockPanel>
                <DockPanel Grid.Row="1" Visibility="{Binding HasStrength, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0" ToolTip="Strength">
                    <Path DockPanel.Dock="Top" Data="{x:Static local:Icons.Strength}" Style="{StaticResource IconPath}" Width="16" Height="16"
                          Stroke="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StrengthText}" FontSize="11" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Slider Style="{StaticResource RailSlider}" Minimum="{Binding StrengthMin}" Maximum="1" Value="{Binding StrengthValue}"
                            AutoToolTipPrecision="2" AutomationProperties.Name="Brush strength" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- Side panel: the prefab browser, validation issues and world info. -->
        <Border x:Name="SidePanel" DockPanel.Dock="Right" Width="{Binding SidePanelWidth}" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Visibility="{Binding SidePanelVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsLandMode, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanBuildLand}">
                <StackPanel x:Name="LandPanel" Margin="16,12">
                    <TextBlock Text="Land" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Drag to draw land. Hold Alt and drag to cut out water." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="Use Select boxes to move a box. Drag a handle to resize it." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Box" Style="{StaticResource OptionLabel}" />
                        <ComboBox ItemsSource="{Binding BoxNames}" SelectedIndex="{Binding SelectedIndex}" HorizontalAlignment="Stretch" AutomationProperties.Name="Box" />
                    </DockPanel>
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding BoxSize}" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Coast seed" Style="{StaticResource OptionLabel}" Width="75" />
                            <Button DockPanel.Dock="Right" Content="Re-roll" Margin="6,0,0,0" Click="RerollLandBox_Click" ToolTip="Give this box a new coast seed" />
                            <TextBox Text="{Binding CoastSeed, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Coast seed" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Fill" Style="{StaticResource OptionLabel}" Width="75" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Fill, StringFormat={}{0}%}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider x:Name="LandFill" Minimum="10" Maximum="80" Value="{Binding Fill}"
                                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" AutomationProperties.Name="Fill"
                                    ToolTip="How much of the box to fill" Thumb.DragStarted="LandSlider_DragStarted" Thumb.DragCompleted="LandSlider_DragCompleted" />
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Roughness" Style="{StaticResource OptionLabel}" Width="75" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Roughness, StringFormat={}{0}%}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding Roughness}" IsSnapToTickEnabled="True" TickFrequency="5"
                                    VerticalAlignment="Center" AutomationProperties.Name="Roughness" ToolTip="Higher values make a more ragged coast"
                                    Thumb.DragStarted="LandSlider_DragStarted" Thumb.DragCompleted="LandSlider_DragCompleted" />
                        </DockPanel>
                        <TextBlock Text="A small island can disappear. Make this box larger or increase Fill."
                                   Visibility="{Binding WarnSmallBox, Converter={StaticResource BoolToVisibility}}"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button Content="Delete box" HorizontalAlignment="Left" Margin="0,10,0,0" Click="DeleteLandBox_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Visibility="{Binding IsWorldMode, Converter={StaticResource BoolToVisibility}}">
                <Button x:Name="SidePanelClose" DockPanel.Dock="Top" HorizontalAlignment="Right" Style="{StaticResource FlatButton}" Content="✕" Padding="8,2" Margin="0,4,4,0"
                        ToolTip="Close the side panel" AutomationProperties.Name="Close side panel" Click="CloseSidePanel_Click" />
                <TabControl x:Name="SideTabs" SelectedIndex="{Binding SidePanelTab}" Margin="8,0,8,8" Background="Transparent" BorderThickness="0">
                    <TabItem Header="_Prefabs">
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBox x:Name="PrefabSearchBox" Text="{Binding PrefabSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                         ToolTip="Search by name, tag or zone (Ctrl+F)" AutomationProperties.Name="Search prefabs" />
                                <ComboBox ItemsSource="{Binding PrefabCategories}" SelectedItem="{Binding PrefabCategory}" Margin="0,6,0,0"
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Category" />
                                <UniformGrid Columns="2" Margin="0,6,0,0">
                                    <ComboBox ItemsSource="{Binding PrefabTiers}" SelectedItem="{Binding PrefabTier}" Margin="0,0,3,0"
                                              HorizontalAlignment="Stretch" AutomationProperties.Name="Tier" />
                                    <ComboBox ItemsSource="{Binding PrefabSizes}" SelectedItem="{Binding PrefabSize}" Margin="3,0,0,0"
                                              HorizontalAlignment="Stretch" AutomationProperties.Name="Size" />
                                </UniformGrid>
                                <TextBlock Text="{Binding PrefabResultsText}" Style="{StaticResource HintText}" Margin="0,6,0,4" />
                            </StackPanel>
                            <ContentControl DockPanel.Dock="Bottom" Content="{Binding SelectedPrefabInfo}" Style="{StaticResource PrefabPreview}"
                                            MaxHeight="170" Margin="0,8,0,0" />
                            <ListBox ItemsSource="{Binding PrefabResults}" SelectedItem="{Binding SelectedPrefabInfo}" AutomationProperties.Name="Prefabs"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Padding="2,0" Margin="-4,0,4,0" Focusable="False"
                                                    Click="FavouriteRow_Click" ToolTip="Favourite (find it under Favourites)" AutomationProperties.Name="Favourite">
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource FavouriteStar}">
                                                            <Binding Path="Name" />
                                                            <Binding Path="DataContext.Favourites" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{StaticResource FavouriteStar}" ConverterParameter="brush">
                                                            <Binding Path="Name" />
                                                            <Binding Path="DataContext.Favourites" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Button>
                                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="6,0,0,0">
                                                <Run Text="{Binding Size.X, Mode=OneWay}" />×<Run Text="{Binding Size.Z, Mode=OneWay}" />
                                            </TextBlock>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Converter={x:Static local:FriendlyNameConverter.Poi}}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="P_laced">
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBox x:Name="PlacedSearchBox" Text="{Binding PlacedSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                         ToolTip="Search the prefabs in this world by name, tag or zone (Ctrl+F)" AutomationProperties.Name="Search placed prefabs" />
                                <ComboBox ItemsSource="{Binding PlacedCategories}" SelectedItem="{Binding PlacedCategory}" Margin="0,6,0,0"
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Placed category" />
                                <TextBlock Text="{Binding PlacedResultsText}" Style="{StaticResource HintText}" Margin="0,6,0,4" />
                            </StackPanel>
                            <ListBox x:Name="PlacedList" ItemsSource="{Binding PlacedResults}" SelectedItem="{Binding SelectedPlaced}"
                                     MouseDoubleClick="Placed_DoubleClick" KeyDown="Placed_KeyDown" AutomationProperties.Name="Placed prefabs"
                                     PreviewMouseLeftButtonUp="Placed_Click"
                                     ToolTip="Click to zoom to it on the map. Double-click or press Enter to also select it"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="_Issues">
                        <DockPanel Margin="0,8,0,0">
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Content="Validate" Command="{x:Static local:MainWindow.ValidateCommand}" Margin="8,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="Teleport list..." Click="ExportTeleportList_Click" Margin="8,0,0,0"
                                        ToolTip="Save a teleport command for each issue, to check them one by one in the game's console (F1)"
                                        AutomationProperties.Name="Export teleport list">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Issues.Count}" Value="0" />
                                                        <Condition Binding="{Binding HasFixedIssues}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="{Binding IssuesText}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,4,0,0"
                                        Visibility="{Binding GameLinkInstalled, Converter={StaticResource BoolToVisibility}}">
                                <CheckBox x:Name="IssueHotkeysCheck" Content="Enable in-game shortcuts" Click="IssueHotkeys_Click" IsEnabled="False"
                                          Margin="0,4,0,0" ToolTip="Teleport to the issue before or after the selected row while the game has focus" />
                                <WrapPanel>
                                    <TextBlock Text="Ctrl+Alt+Left · Before selection" Style="{StaticResource HintText}" Margin="0,0,12,0" />
                                    <TextBlock Text="Ctrl+Alt+Right · After selection" Style="{StaticResource HintText}" />
                                </WrapPanel>
                            </StackPanel>
                            <ListBox x:Name="IssuesList" ItemsSource="{Binding Issues}" Margin="0,8,0,0" MouseDoubleClick="Issue_DoubleClick"
                                     SelectionChanged="Issues_SelectionChanged" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch"
                                     KeyDown="Issue_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Issues" ToolTip="Double-click or press Enter to find it on the map">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Teleport" Click="TeleportIssue_Click" Margin="6,0,0,0"
                                                    Padding="8,1" FontSize="12" VerticalAlignment="Top"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    IsEnabled="{Binding DataContext.CanTeleportIssues, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="ToolTip" Value="Teleport to this issue in the game" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.GameLinkConnected, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
                                                                <Setter Property="ToolTip" Value="Start 7 Days to Die with Game Link to teleport." />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding HasLocation}" Value="True" />
                                                                    <Condition Binding="{Binding DataContext.GameLinkInstalled, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <!-- A fix, on issues that have one safe answer (#40). -->
                                            <Button DockPanel.Dock="Right" Content="{Binding Fix.Label}" Click="IssueFix_Click" Margin="6,0,0,0"
                                                    Padding="8,1" FontSize="12" VerticalAlignment="Top"
                                                    ToolTip="Fix this as one undo step; Validate runs again after">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Fix}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock DockPanel.Dock="Left" Width="20" FontWeight="Bold"
                                                       Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Wo_rld">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding WorldSummary}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap" />
                                <TextBlock Text="Game folder" FontWeight="SemiBold" Margin="0,16,0,4" />
                                <TextBlock Text="{Binding GameFolderText}" Style="{StaticResource HintText}" />
                                <Button Content="Change..." HorizontalAlignment="Left" Margin="0,8,0,0" Click="GameFolder_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="_Generate">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel IsEnabled="{Binding Generate.HasWorld}">
                                <StackPanel.Resources>
                                    <Style x:Key="GenLabel" TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                    </Style>
                                    <Style x:Key="WeightBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="Margin" Value="0,0,6,0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                </StackPanel.Resources>

                                <TextBlock Text="Make the world in stages, as the game's generator does. Each stage is one undo step."
                                           Style="{StaticResource HintText}" TextWrapping="Wrap" />

                                <!-- World seed: every stage's seed comes from it. -->
                                <TextBlock Text="World seed" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <DockPanel IsEnabled="{Binding Generate.CanEdit}">
                                    <Button DockPanel.Dock="Right" Content="New" Margin="6,0,0,0" Click="GenerateNewWorldSeed_Click"
                                            ToolTip="Pick a new world seed; every stage's seed follows it" />
                                    <TextBox Text="{Binding Generate.WorldSeed, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="World seed"
                                             ToolTip="Gives each stage its seed, so the same seeds always make the same world" />
                                </DockPanel>

                                <!-- Presets: every stage's settings by name. -->
                                <TextBlock Text="Preset" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <DockPanel IsEnabled="{Binding Generate.CanEdit}">
                                    <Button DockPanel.Dock="Right" Content="Delete" Margin="6,0,0,0" Click="PresetDelete_Click"
                                            ToolTip="Delete the chosen preset" />
                                    <Button DockPanel.Dock="Right" Content="Use" Margin="6,0,0,0" Click="PresetUse_Click"
                                            ToolTip="Take the chosen preset's settings. The seeds, edges and painted tiles stay this world's." />
                                    <ComboBox x:Name="PresetBox" ItemsSource="{Binding Generate.Presets}" DisplayMemberPath="Name" MinWidth="0"
                                              HorizontalAlignment="Stretch" AutomationProperties.Name="Preset" />
                                </DockPanel>
                                <TextBlock Text="{Binding SelectedItem.Summary, ElementName=PresetBox}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <DockPanel Margin="0,6,0,0" IsEnabled="{Binding Generate.CanEdit}">
                                    <Button DockPanel.Dock="Right" Content="Save" Margin="6,0,0,0" Click="PresetSave_Click"
                                            ToolTip="Save the settings below under this name" />
                                    <TextBox Text="{Binding Generate.PresetName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Preset name"
                                             ToolTip="A name to save the settings under" />
                                </DockPanel>

                                <!-- Stage 1: terrain. -->
                                <Expander Style="{StaticResource StageExpander}" Margin="0,16,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          IsExpanded="{Binding Generate.OpenStage, Converter={StaticResource StageOpen}, ConverterParameter=1}">
                                    <Expander.Header>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="1  Terrain" FontWeight="SemiBold" FontSize="15" />
                                                <Border Style="{StaticResource DoneBadge}"
                                                           Visibility="{Binding Generate.TerrainDone, Converter={StaticResource BoolToVisibility}}">
                                                           <TextBlock Text="Done" />
                                                           </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Generate.TerrainStatusLine}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       ToolTip="{Binding Generate.TerrainStatus}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel>

                                        <StackPanel IsEnabled="{Binding Generate.CanEdit}">
                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="Seed" Style="{StaticResource GenLabel}" />
                                                <Button DockPanel.Dock="Right" Content="Re-roll" Margin="6,0,0,0" Click="TerrainReroll_Click"
                                                        ToolTip="Generate again with a new seed" />
                                                <TextBox Text="{Binding Generate.TerrainSeed, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Terrain seed" />
                                            </DockPanel>

                                            <TextBlock Text="How much of each biome gets plains, hills and mountains. The numbers are compared with each other; the game uses 4, 4, 2."
                                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,10,0,4" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Plains" Style="{StaticResource HintText}" />
                                                    <TextBox Text="{Binding Generate.Plains, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Plains weight" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                    <TextBlock Text="Hills" Style="{StaticResource HintText}" />
                                                    <TextBox Text="{Binding Generate.Hills, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Hills weight" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Mountains" Style="{StaticResource HintText}" />
                                                    <TextBox Text="{Binding Generate.Mountains, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Mountains weight" />
                                                </StackPanel>
                                            </Grid>

                                            <Expander Style="{StaticResource LinkExpander}" Header="Per biome" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                                <StackPanel>
                                                    <TextBlock Text="Tick a biome to give it its own plains, hills and mountains. Unticked wasteland gets no mountains, as in the game."
                                                               Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                    <ItemsControl ItemsSource="{Binding Generate.BiomeRows}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="44" />
                                                                        <ColumnDefinition Width="44" />
                                                                        <ColumnDefinition Width="44" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Own}" MinWidth="0" VerticalAlignment="Center" />
                                                                    <TextBox Grid.Column="1" Text="{Binding Plains, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding Own}"
                                                                             Style="{StaticResource WeightBox}" ToolTip="Plains" />
                                                                    <TextBox Grid.Column="2" Text="{Binding Hills, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding Own}"
                                                                             Style="{StaticResource WeightBox}" ToolTip="Hills" />
                                                                    <TextBox Grid.Column="3" Text="{Binding Mountains, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding Own}"
                                                                             Style="{StaticResource WeightBox}" ToolTip="Mountains" Margin="0" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>

                                            <TextBlock Text="Land shape, redrawn when the whole map is generated" Style="{StaticResource HintText}" Margin="0,10,0,4" />
                                            <ComboBox ItemsSource="{Binding Generate.ShapeKinds}" DisplayMemberPath="Label" SelectedValuePath="Kind"
                                                      SelectedValue="{Binding Generate.ShapeKind}" HorizontalAlignment="Stretch" AutomationProperties.Name="Land shape"
                                                      ToolTip="Use a preset land shape or draw your own" />
                                            <Button Content="Edit land" Click="EditLand_Click" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                    Visibility="{Binding Generate.IsDrawn, Converter={StaticResource BoolToVisibility}}" />
                                            <StackPanel Visibility="{Binding Generate.HasCoastSettings, Converter={StaticResource BoolToVisibility}}">
                                                <DockPanel Margin="0,6,0,0">
                                                    <TextBlock DockPanel.Dock="Left" Text="Coast seed" Style="{StaticResource GenLabel}" />
                                                    <Button DockPanel.Dock="Right" Content="Re-roll" Margin="6,0,0,0" Click="CoastReroll_Click"
                                                            ToolTip="Generate again with a new coastline; the terrain seed stays" />
                                                    <TextBox Text="{Binding Generate.CoastSeed, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Coast seed" />
                                                </DockPanel>
                                                <DockPanel Margin="0,6,0,0">
                                                    <TextBlock DockPanel.Dock="Left" Text="Land" Style="{StaticResource GenLabel}" Width="70" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Generate.LandPercent, StringFormat={}{0}%}" Width="36" TextAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                    <Slider Minimum="10" Maximum="80" Value="{Binding Generate.LandPercent}" IsSnapToTickEnabled="True" TickFrequency="1"
                                                            VerticalAlignment="Center" AutomationProperties.Name="Land share" ToolTip="Share of the map that is land" />
                                                </DockPanel>
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock DockPanel.Dock="Left" Text="Rough coast" Style="{StaticResource GenLabel}" Width="70" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Generate.Roughness, StringFormat={}{0}%}" Width="36" TextAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                    <Slider Minimum="0" Maximum="100" Value="{Binding Generate.Roughness}" IsSnapToTickEnabled="True" TickFrequency="5"
                                                            VerticalAlignment="Center" AutomationProperties.Name="Coastline roughness"
                                                            ToolTip="How ragged the coastline is: smooth at 0, bays and headlands at 100" />
                                                </DockPanel>
                                                <DockPanel Margin="0,4,0,0" Visibility="{Binding Generate.IsArchipelago, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock DockPanel.Dock="Left" Text="Islands" Style="{StaticResource GenLabel}" Width="70" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Generate.Islands}" Width="36" TextAlignment="Right" VerticalAlignment="Center" />
                                                    <Slider Minimum="2" Maximum="12" Value="{Binding Generate.Islands}" IsSnapToTickEnabled="True" TickFrequency="1"
                                                            VerticalAlignment="Center" AutomationProperties.Name="Islands"
                                                            ToolTip="How many islands to start with; small ones may be dropped" />
                                                </DockPanel>
                                                <DockPanel Margin="0,4,0,0" Visibility="{Binding Generate.IsPeninsula, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock DockPanel.Dock="Left" Text="Joined to" Style="{StaticResource GenLabel}" Width="70" />
                                                    <ComboBox ItemsSource="{Binding Generate.MapEdges}" SelectedItem="{Binding Generate.PeninsulaEdge}" HorizontalAlignment="Stretch"
                                                              AutomationProperties.Name="Peninsula edge" ToolTip="The edge the peninsula is joined to" />
                                                </DockPanel>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding Generate.CanReplanBiomes, Converter={StaticResource BoolToVisibility}}"
                                                        IsEnabled="{Binding Generate.WholeMap}">
                                                <CheckBox Content="Plan the biomes again for this land" IsChecked="{Binding Generate.ReplanBiomes}" Margin="0,6,0,0"
                                                          ToolTip="Lays New World's biome layout out again to fit the land (whole-map runs only). Replaces biomes painted by hand; undo puts them back." />
                                                <DockPanel Margin="0,6,0,0" Visibility="{Binding Generate.ReplanBiomes, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock DockPanel.Dock="Left" Text="Biome seed" Style="{StaticResource GenLabel}" />
                                                    <Button DockPanel.Dock="Right" Content="Re-roll" Margin="6,0,0,0" Click="BiomeReroll_Click"
                                                            ToolTip="Plan new biomes on the ground as it is; the terrain is not generated again" />
                                                    <TextBox Text="{Binding Generate.BiomeSeed, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Biome seed" />
                                                </DockPanel>
                                                <DockPanel Margin="0,6,0,0" Visibility="{Binding Generate.ReplanBiomes, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock DockPanel.Dock="Left" Text="Layout" Style="{StaticResource GenLabel}" />
                                                    <ComboBox ItemsSource="{Binding Generate.BiomeLayouts}" SelectedItem="{Binding Generate.BiomeLayout}"
                                                              DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Biome layout"
                                                              ToolTip="Where each biome goes. On an archipelago, One biome per island gives each island one biome: forest first, harder ones farther out, each close to its share of the land." />
                                                </DockPanel>
                                            </StackPanel>

                                            <TextBlock Text="Edges, redrawn when the whole map is generated" Style="{StaticResource HintText}" Margin="0,10,0,4"
                                                       Visibility="{Binding Generate.IsEdges, Converter={StaticResource BoolToVisibility}}" />
                                            <UniformGrid Columns="2" Visibility="{Binding Generate.IsEdges, Converter={StaticResource BoolToVisibility}}">
                                                <ComboBox ItemsSource="{Binding Generate.EdgeStyles}" SelectedItem="{Binding Generate.EdgeNorth}" Margin="0,0,4,4"
                                                          ToolTip="North edge" AutomationProperties.Name="North edge" HorizontalAlignment="Stretch" />
                                                <ComboBox ItemsSource="{Binding Generate.EdgeStyles}" SelectedItem="{Binding Generate.EdgeEast}" Margin="0,0,0,4"
                                                          ToolTip="East edge" AutomationProperties.Name="East edge" HorizontalAlignment="Stretch" />
                                                <ComboBox ItemsSource="{Binding Generate.EdgeStyles}" SelectedItem="{Binding Generate.EdgeSouth}" Margin="0,0,4,0"
                                                          ToolTip="South edge" AutomationProperties.Name="South edge" HorizontalAlignment="Stretch" />
                                                <ComboBox ItemsSource="{Binding Generate.EdgeStyles}" SelectedItem="{Binding Generate.EdgeWest}"
                                                          ToolTip="West edge" AutomationProperties.Name="West edge" HorizontalAlignment="Stretch" />
                                            </UniformGrid>

                                            <TextBlock Text="Where" Style="{StaticResource HintText}" Margin="0,10,0,2" />
                                            <RadioButton Content="Whole map" IsChecked="{Binding Generate.WholeMap}" GroupName="GenArea" />
                                            <RadioButton Content="Only an area" IsChecked="{Binding Generate.IsArea}" GroupName="GenArea"
                                                         ToolTip="Remake only the tiles in a rectangle, blended into the land around them. Prefabs and roads stay put." />
                                            <DockPanel Margin="26,2,0,0" IsEnabled="{Binding Generate.IsArea}">
                                                <Button DockPanel.Dock="Left" Content="Select area" Click="GenerateSelectArea_Click" Margin="0,0,8,0"
                                                        ToolTip="Drag a rectangle on the map" />
                                                <TextBlock Text="{Binding Generate.AreaText}" Style="{StaticResource HintText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>

                                            <TextBlock Text="Tile types painted by hand; generating fills the rest" Style="{StaticResource HintText}"
                                                       TextWrapping="Wrap" Margin="0,10,0,4" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Left" Click="GeneratePaintTiles_Click" Margin="0,0,6,0"
                                                        ToolTip="Paint the chosen type onto 256 m tiles; Shift+drag clears">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{x:Static local:Icons.TileTypes}" Style="{StaticResource IconPath}" Width="14" Height="14" Margin="0,0,6,0" />
                                                        <TextBlock Text="Paint" />
                                                    </StackPanel>
                                                </Button>
                                                <Button DockPanel.Dock="Right" Content="Clear" Margin="6,0,0,0" Click="GenerateClearPainted_Click"
                                                        ToolTip="Clear every painted tile" />
                                                <ComboBox ItemsSource="{Binding Generate.PaintTypes}" SelectedItem="{Binding Generate.PaintType}"
                                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Tile type to paint">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Rectangle Width="12" Height="12" Margin="0,0,8,0" Fill="{Binding Converter={StaticResource TerrainTypeBrush}}"
                                                                           Stroke="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Generate.PaintedText}" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                                            <CheckBox Content="Show the last run's tile types" IsChecked="{Binding Generate.ShowPlan}" Margin="0,2,0,0"
                                                      ToolTip="Tint every tile by the type the last Generate gave it" />
                                        </StackPanel>

                                        <DockPanel Margin="0,12,0,0">
                                            <Button DockPanel.Dock="Left" Content="Generate" Style="{DynamicResource AccentButtonStyle}" MinWidth="100"
                                                    IsEnabled="{Binding Generate.CanGenerate}" Click="TerrainGenerate_Click" />
                                            <Button DockPanel.Dock="Left" Content="Cancel" Margin="6,0,0,0" Click="GenerateCancel_Click"
                                                    Visibility="{Binding Generate.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                            <ProgressBar Maximum="1" Value="{Binding Generate.Progress}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                         Visibility="{Binding Generate.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Expander>

                                <!-- Stage 2: town sites. -->
                                <Expander Style="{StaticResource StageExpander}" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          IsExpanded="{Binding Generate.OpenStage, Converter={StaticResource StageOpen}, ConverterParameter=2}">
                                    <Expander.Header>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="2  Town sites" FontWeight="SemiBold" FontSize="15" />
                                                <Border Style="{StaticResource DoneBadge}"
                                                           Visibility="{Binding Generate.TownDone, Converter={StaticResource BoolToVisibility}}">
                                                           <TextBlock Text="Done" />
                                                           </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Generate.TownStatusLine}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       ToolTip="{Binding Generate.TownStatus}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel>

                                        <StackPanel IsEnabled="{Binding Generate.CanEdit}">
                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="Seed" Style="{StaticResource GenLabel}" />
                                                <Button DockPanel.Dock="Right" Content="Re-roll" Margin="6,0,0,0" Click="TownsReroll_Click"
                                                        ToolTip="Plan again with a new seed. Towns you added or pinned stay." />
                                                <TextBox Text="{Binding Generate.TownSeed, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Town seed" />
                                            </DockPanel>

                                            <TextBlock Text="How many towns of each type, and how big each can grow. Size is counted in street tiles (one tile is 150 m); the last column shows roughly how wide that is. Starts at the game's numbers for this world size."
                                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,10,0,4" />
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Town type" Style="{StaticResource HintText}" />
                                                <TextBlock Grid.Column="1" Text="How many" Style="{StaticResource HintText}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" ToolTip="How many towns of this type, in all" />
                                                <TextBlock Grid.Column="2" Text="Smallest" Style="{StaticResource HintText}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" ToolTip="Fewest street tiles (150 m each) in one town" />
                                                <TextBlock Grid.Column="3" Text="Biggest" Style="{StaticResource HintText}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" ToolTip="Most street tiles (150 m each) in one town" />
                                                <TextBlock Grid.Column="4" Text="About" Style="{StaticResource HintText}" HorizontalAlignment="Center" ToolTip="Roughly how wide a town is at that size" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Generate.TownRows}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="52" />
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="84" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Description}">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Description}" Style="{StaticResource HintText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBox Grid.Column="1" Text="{Binding Count, UpdateSourceTrigger=LostFocus}" Style="{StaticResource WeightBox}" ToolTip="How many towns of this type, in all" />
                                                            <TextBox Grid.Column="2" Text="{Binding MinTiles, UpdateSourceTrigger=LostFocus}" Style="{StaticResource WeightBox}" ToolTip="Fewest street tiles (150 m each) in one town" />
                                                            <TextBox Grid.Column="3" Text="{Binding MaxTiles, UpdateSourceTrigger=LostFocus}" Style="{StaticResource WeightBox}" ToolTip="Most street tiles (150 m each) in one town" />
                                                            <TextBlock Grid.Column="4" Text="{Binding SizeText}" Style="{StaticResource HintText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                       ToolTip="Roughly how wide a town is at its smallest and biggest" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Generate.TownTotalText}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <Button Content="Game numbers" HorizontalAlignment="Left" Margin="0,4,0,0" Click="TownsDefaults_Click"
                                                    ToolTip="Put back the game's counts and sizes for this world size" />

                                            <CheckBox Content="One trader per town" Margin="0,8,0,0" IsChecked="{Binding Generate.OneTraderPerTown}"
                                                      ToolTip="Off: the game's way, each biome's own trader, 2 to 4 of each in that biome's biggest towns. On: every town gets one trader." />
                                            <CheckBox Content="Let towns cross biome borders" Margin="0,4,0,0" IsChecked="{Binding Generate.TownsCrossBorders}"
                                                      ToolTip="Off: the game's way, every street tile in one biome, so towns stop short of borders. On: a town can straddle a border; each lot still gets POIs and traders for the biome under it." />
                                            <Expander Style="{StaticResource LinkExpander}" Header="Spacing and biomes" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBox DockPanel.Dock="Right" Width="50" Text="{Binding Generate.EdgeMarginPercent, UpdateSourceTrigger=LostFocus}"
                                                                 AutomationProperties.Name="Edge margin" />
                                                        <TextBlock Text="Keep towns off the edge (% of the map; the game's is 10)" Style="{StaticResource HintText}"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Text="Apart: the fewest street tiles to another town. Biomes: where a town may start (forest, burntforest, desert, snow, wasteland); empty for the game's list."
                                                               Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                    <ItemsControl ItemsSource="{Binding Generate.TownRows}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="40" />
                                                                        <ColumnDefinition Width="110" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                                    <TextBox Grid.Column="1" Text="{Binding Distance, UpdateSourceTrigger=LostFocus}" Style="{StaticResource WeightBox}" ToolTip="Apart" />
                                                                    <TextBox Grid.Column="2" Text="{Binding Biomes, UpdateSourceTrigger=LostFocus}" Style="{StaticResource WeightBox}" Margin="0"
                                                                             HorizontalContentAlignment="Left" ToolTip="Biomes it may start in" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>

                                        <DockPanel Margin="0,12,0,0">
                                            <Button DockPanel.Dock="Left" Content="Plan towns" Style="{DynamicResource AccentButtonStyle}" MinWidth="100"
                                                    IsEnabled="{Binding Generate.CanEdit}" Click="TownsPlan_Click"
                                                    ToolTip="Pick the sites and plan every town. Nothing changes in the world until Build." />
                                            <Button DockPanel.Dock="Left" Content="Build" Margin="6,0,0,0" IsEnabled="{Binding Generate.HasPlan}" Click="TownsBuild_Click"
                                                    ToolTip="Build every planned town as one undo step" />
                                            <Button DockPanel.Dock="Left" Content="Clear" Margin="6,0,0,0" IsEnabled="{Binding Generate.HasPlan}" Click="TownsClear_Click"
                                                    ToolTip="Drop every planned town, pinned ones too" />
                                            <Border />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Generate.PlanText}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />

                                        <!-- Review: the town picked on the map. -->
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Click="TownsReview_Click"
                                                ToolTip="Pick, move and add towns on the map">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{x:Static local:Icons.Town}" Style="{StaticResource IconPath}" Width="14" Height="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Review on the map" />
                                            </StackPanel>
                                        </Button>
                                        <DockPanel Margin="0,6,0,0" IsEnabled="{Binding Generate.CanEdit}">
                                            <TextBlock DockPanel.Dock="Left" Text="Add as" Style="{StaticResource GenLabel}" />
                                            <ComboBox ItemsSource="{Binding Generate.TownshipNames}" SelectedItem="{Binding Generate.AddTownship}"
                                                      HorizontalAlignment="Stretch" AutomationProperties.Name="Township for towns added by hand"
                                                      ToolTip="The township a town dragged out on the map becomes">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={x:Static local:FriendlyNameConverter.Township}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DockPanel>
                                        <Border Margin="0,8,0,0" Padding="8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                Visibility="{Binding Generate.HasSelectedSite, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel IsEnabled="{Binding Generate.CanEdit}">
                                                <TextBlock Text="{Binding Generate.SelectedSiteText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <DockPanel Margin="0,6,0,0">
                                                    <TextBox DockPanel.Dock="Right" Width="50" Margin="6,0,0,0" Text="{Binding Generate.SelectedSize, UpdateSourceTrigger=LostFocus}"
                                                             AutomationProperties.Name="Street tiles" ToolTip="Street tiles" />
                                                    <ComboBox ItemsSource="{Binding Generate.TownshipNames}" SelectedItem="{Binding Generate.SelectedTownship}"
                                                              HorizontalAlignment="Stretch" AutomationProperties.Name="Township">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={x:Static local:FriendlyNameConverter.Township}}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </DockPanel>
                                                <DockPanel Margin="0,6,0,0">
                                                    <Button DockPanel.Dock="Left" Content="Re-roll" Click="SiteReroll_Click" ToolTip="Plan this town again with a new seed" />
                                                    <Button DockPanel.Dock="Left" Content="Drop" Margin="6,0,0,0" Click="SiteDrop_Click" ToolTip="Remove this town from the plan" />
                                                    <CheckBox Content="Pinned" IsChecked="{Binding Generate.SelectedPinned}" Margin="10,0,0,0" MinWidth="0"
                                                              ToolTip="Keep this town when the stage is re-rolled" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Expander>

                                <!-- Stage 3: lakes, rivers, canyons and craters. -->
                                <Expander Style="{StaticResource StageExpander}" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          IsExpanded="{Binding Generate.OpenStage, Converter={StaticResource StageOpen}, ConverterParameter=3}">
                                    <Expander.Header>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="3  Lakes, rivers, canyons, craters" FontWeight="SemiBold" FontSize="15" />
                                                <Border Style="{StaticResource DoneBadge}"
                                                           Visibility="{Binding Generate.FeatureDone, Converter={StaticResource BoolToVisibility}}">
                                                           <TextBlock Text="Done" />
                                                           </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Generate.FeatureStatusLine}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       ToolTip="{Binding Generate.FeatureStatus}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel>

                                        <StackPanel IsEnabled="{Binding Generate.CanEdit}">
                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="Seed" Style="{StaticResource GenLabel}" />
                                                <Button DockPanel.Dock="Right" Content="Re-roll" Margin="6,0,0,0" Click="FeaturesReroll_Click"
                                                        ToolTip="Generate again with a new seed. Features you placed or pinned stay." />
                                                <TextBox Text="{Binding Generate.FeatureSeed, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Feature seed" />
                                            </DockPanel>

                                            <TextBlock Text="How many of each, and their size (the game's scale; 1 is a stamp of about 700 m). Starts at the game's numbers for this world size; what doesn't fit is left out."
                                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,10,0,4" />
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Feature" Style="{StaticResource HintText}" />
                                                <TextBlock Grid.Column="1" Text="Count" Style="{StaticResource HintText}" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="Size min" Style="{StaticResource HintText}" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="Size max" Style="{StaticResource HintText}" HorizontalAlignment="Center" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Generate.FeatureRows}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="44" />
                                                                <ColumnDefinition Width="48" />
                                                                <ColumnDefinition Width="48" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" />
                                                                <TextBlock Text="{Binding GameNote}" Style="{StaticResource HintText}" />
                                                            </StackPanel>
                                                            <TextBox Grid.Column="1" Text="{Binding Count, UpdateSourceTrigger=LostFocus}" Style="{StaticResource WeightBox}" ToolTip="How many" />
                                                            <TextBox Grid.Column="2" Text="{Binding ScaleMin, UpdateSourceTrigger=LostFocus}" Style="{StaticResource WeightBox}" ToolTip="Smallest scale" />
                                                            <TextBox Grid.Column="3" Text="{Binding ScaleMax, UpdateSourceTrigger=LostFocus}" Style="{StaticResource WeightBox}" ToolTip="Largest scale" Margin="0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="Game numbers" HorizontalAlignment="Left" Margin="0,4,0,0" Click="FeaturesDefaults_Click"
                                                    ToolTip="Put back the game's counts and sizes for this world size" />

                                            <CheckBox Content="Mountain lakes" IsChecked="{Binding Generate.MountainLakes}" Margin="0,10,0,0"
                                                      ToolTip="Lakes fill at their own ground level instead of the game's fixed 30 m, so they hold water on high ground and may sit in the mountains" />
                                            <CheckBox Content="Long rivers" IsChecked="{Binding Generate.LongRivers}" Margin="0,4,0,0"
                                                      ToolTip="Each river runs downhill, stamp after stamp, until it reaches water or the edge; one that runs dry ends in a lake" />
                                            <DockPanel Margin="24,4,0,0" IsEnabled="{Binding Generate.LongRivers}">
                                                <TextBox DockPanel.Dock="Right" Width="50" Text="{Binding Generate.RiverSegments, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="River stamps" />
                                                <TextBlock Text="Most stamps in one river" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </StackPanel>

                                        <DockPanel Margin="0,12,0,0">
                                            <Button DockPanel.Dock="Left" Content="Generate" Style="{DynamicResource AccentButtonStyle}" MinWidth="100"
                                                    IsEnabled="{Binding Generate.CanEdit}" Click="FeaturesGenerate_Click"
                                                    ToolTip="Take out the last run's features and press in new ones, as one undo step. Placed and pinned ones stay." />
                                            <Button DockPanel.Dock="Left" Content="Remove all" Margin="6,0,0,0" IsEnabled="{Binding Generate.CanEdit}" Click="FeaturesRemove_Click"
                                                    ToolTip="Take every feature out of the world, pinned ones too, as one undo step" />
                                            <Border />
                                        </DockPanel>

                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Click="FeaturesPlace_Click"
                                                ToolTip="Click empty ground to place a feature there, pinned; click a feature to pick it">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{x:Static local:Icons.Water}" Style="{StaticResource IconPath}" Width="14" Height="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Place on the map" />
                                            </StackPanel>
                                        </Button>
                                        <DockPanel Margin="0,6,0,0" IsEnabled="{Binding Generate.CanEdit}">
                                            <TextBlock DockPanel.Dock="Left" Text="Place" Style="{StaticResource GenLabel}" />
                                            <ComboBox ItemsSource="{Binding Generate.FeatureKinds}" SelectedItem="{Binding Generate.PlaceKind}"
                                                      HorizontalAlignment="Stretch" AutomationProperties.Name="Feature to place by hand" />
                                        </DockPanel>
                                        <Border Margin="0,8,0,0" Padding="8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                Visibility="{Binding Generate.HasSelectedFeature, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel IsEnabled="{Binding Generate.CanEdit}">
                                                <TextBlock Text="{Binding Generate.SelectedFeatureText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <DockPanel Margin="0,6,0,0">
                                                    <Button DockPanel.Dock="Left" Content="Drop" Click="FeatureDrop_Click" ToolTip="Take this feature out of the world (a long river goes whole)" />
                                                    <CheckBox Content="Pinned" IsChecked="{Binding Generate.SelectedFeaturePinned}" Margin="10,0,0,0" MinWidth="0"
                                                              ToolTip="Keep this feature when the stage is generated again" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Expander>

                                <!-- Stage 4: highways. -->
                                <Expander Style="{StaticResource StageExpander}" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          IsExpanded="{Binding Generate.OpenStage, Converter={StaticResource StageOpen}, ConverterParameter=4}">
                                    <Expander.Header>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="4  Highways" FontWeight="SemiBold" FontSize="15" />
                                                <Border Style="{StaticResource DoneBadge}"
                                                           Visibility="{Binding Generate.HighwayDone, Converter={StaticResource BoolToVisibility}}">
                                                           <TextBlock Text="Done" />
                                                           </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Generate.HighwayStatusLine}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       ToolTip="{Binding Generate.HighwayStatus}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel>

                                        <StackPanel IsEnabled="{Binding Generate.CanEdit}">
                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="Seed" Style="{StaticResource GenLabel}" />
                                                <Button DockPanel.Dock="Right" Content="Re-roll" Margin="6,0,0,0" Click="HighwaysReroll_Click"
                                                        ToolTip="Generate again with a new seed, which bends the routes another way" />
                                                <TextBox Text="{Binding Generate.HighwaySeed, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Highway seed" />
                                            </DockPanel>
                                            <Expander Style="{StaticResource LinkExpander}" Header="How the game does it" Margin="0,10,0,4" HorizontalAlignment="Stretch">
                                                <TextBlock Text="Joins the towns the game's way: each gateway to the cheapest of its three nearest towns, rings round big cities, gravel roads from towns without gateways."
                                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                            </Expander>
                                            <DockPanel Margin="0,4,0,0">
                                                <TextBox DockPanel.Dock="Right" Width="50" Text="{Binding Generate.WigglePercent, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="Route wiggle" />
                                                <TextBlock Text="Route wiggle from the seed (%; 0 for the game's exact routes)" Style="{StaticResource HintText}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Margin="0,4,0,0">
                                                <TextBox DockPanel.Dock="Right" Width="50" Text="{Binding Generate.CausewayMax, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="Longest causeway" />
                                                <TextBlock Text="Longest causeway over water (m); wider water is gone round" Style="{StaticResource HintText}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <CheckBox Content="Join every town" IsChecked="{Binding Generate.JoinUp}" Margin="0,6,0,0"
                                                      ToolTip="After the game's rules, join any group of towns cut off from the rest to its nearest neighbours" />
                                            <CheckBox Content="Bridge islands" IsChecked="{Binding Generate.Bridges}" Margin="26,6,0,0" IsEnabled="{Binding Generate.JoinUp}"
                                                      ToolTip="Join towns on separate islands with the game's bridge sections, straight north-south or east-west, with open water under them for boats" />
                                            <DockPanel Margin="26,4,0,0" IsEnabled="{Binding Generate.JoinUp}"
                                                       Visibility="{Binding Generate.Bridges, Converter={StaticResource BoolToVisibility}}">
                                                <TextBox DockPanel.Dock="Right" Width="50" Text="{Binding Generate.BridgeMax, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="Longest bridge" />
                                                <TextBlock Text="Longest bridge over water (m)" Style="{StaticResource HintText}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <CheckBox Content="Shortcut bridges" IsChecked="{Binding Generate.BridgeShortcuts}" Margin="26,6,0,0" IsEnabled="{Binding Generate.JoinUp}"
                                                      Visibility="{Binding Generate.Bridges, Converter={StaticResource BoolToVisibility}}"
                                                      ToolTip="Once every island is joined, also bridge two islands straight across where the way round takes 3 or more bridges" />
                                            <CheckBox Content="Car wrecks on bridges" IsChecked="{Binding Generate.DeckWrecks}" Margin="26,6,0,0" IsEnabled="{Binding Generate.JoinUp}"
                                                      Visibility="{Binding Generate.Bridges, Converter={StaticResource BoolToVisibility}}"
                                                      ToolTip="Stand a car wreck on each bridge deck about every 100 to 150 m, picked from the seed, so the same seed gives the same wrecks" />
                                            <CheckBox Content="Allow a second road between two towns" IsChecked="{Binding Generate.SecondRoad}" Margin="0,6,0,0"
                                                      ToolTip="The game can join two towns with two highways that run side by side. Off: one highway per pair of towns" />
                                        </StackPanel>

                                        <DockPanel Margin="0,12,0,0">
                                            <Button DockPanel.Dock="Left" Content="Generate" Style="{DynamicResource AccentButtonStyle}" MinWidth="100"
                                                    IsEnabled="{Binding Generate.CanEdit}" Click="HighwaysGenerate_Click"
                                                    ToolTip="Take out the last run's roads and lay new ones between the built towns, as one undo step" />
                                            <Button DockPanel.Dock="Left" Content="Remove all" Margin="6,0,0,0" IsEnabled="{Binding Generate.HasHighways}" Click="HighwaysRemove_Click"
                                                    ToolTip="Take out every road this stage laid, putting back the ground under it, as one undo step" />
                                            <Border />
                                        </DockPanel>
                                    </StackPanel>
                                </Expander>

                                <!-- Stage 5: wilderness POIs and gravel roads. -->
                                <Expander Style="{StaticResource StageExpander}" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          IsExpanded="{Binding Generate.OpenStage, Converter={StaticResource StageOpen}, ConverterParameter=5}">
                                    <Expander.Header>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="5  Wilderness POIs and gravel roads" FontWeight="SemiBold" FontSize="15" />
                                                <Border Style="{StaticResource DoneBadge}"
                                                           Visibility="{Binding Generate.WildernessDone, Converter={StaticResource BoolToVisibility}}">
                                                           <TextBlock Text="Done" />
                                                           </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Generate.WildernessStatusLine}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       ToolTip="{Binding Generate.WildernessStatus}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel>

                                        <StackPanel IsEnabled="{Binding Generate.CanEdit}">
                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="Seed" Style="{StaticResource GenLabel}" />
                                                <Button DockPanel.Dock="Right" Content="Re-roll" Margin="6,0,0,0" Click="WildernessReroll_Click"
                                                        ToolTip="Generate again with a new seed. POIs you placed or pinned stay." />
                                                <TextBox Text="{Binding Generate.WildernessSeed, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Wilderness seed" />
                                            </DockPanel>
                                            <Expander Style="{StaticResource LinkExpander}" Header="How the game does it" Margin="0,10,0,4" HorizontalAlignment="Stretch">
                                                <TextBlock Text="The game's way: in each biome, free 150 m cells far from towns go first, each getting the best scoring wilderness POI that fits on dry, flat-enough ground of one biome."
                                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                            </Expander>
                                            <DockPanel Margin="0,4,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="Game count" Style="{StaticResource GenLabel}" />
                                                <TextBox DockPanel.Dock="Right" Width="50" Margin="6,0,0,0" Text="{Binding Generate.WildernessPercent, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="Wilderness count percent" ToolTip="The game's count times this, in percent" />
                                                <TextBlock DockPanel.Dock="Right" Text="×%" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                <ComboBox ItemsSource="{Binding Generate.WildernessAmounts}" SelectedIndex="{Binding Generate.WildernessAmount}"
                                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Wilderness count" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Generate.WildernessCountsText}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="Tiers" Style="{StaticResource GenLabel}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Generate.WildernessTierText}" Style="{StaticResource HintText}"
                                                           VerticalAlignment="Center" Width="96" Margin="6,0,0,0" />
                                                <Slider Minimum="-100" Maximum="100" SmallChange="10" LargeChange="25" IsSnapToTickEnabled="True" TickFrequency="5"
                                                        Value="{Binding Generate.WildernessTier}" AutomationProperties.Name="Tier mix"
                                                        ToolTip="Left for easier POIs, right for harder ones; the middle is the game's mix" />
                                            </DockPanel>
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBox DockPanel.Dock="Right" Width="50" Text="{Binding Generate.WildernessGap, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="Gap from towns and roads" />
                                                <TextBlock Text="Gap from towns and roads (m)" Style="{StaticResource HintText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <CheckBox Content="Gravel roads" IsChecked="{Binding Generate.WildernessRoads}" Margin="0,8,0,0"
                                                      ToolTip="A gravel road from each POI's road exit to the nearest road, as the game lays them" />
                                            <DockPanel Margin="24,4,0,0" IsEnabled="{Binding Generate.WildernessRoads}">
                                                <TextBox DockPanel.Dock="Right" Width="50" Text="{Binding Generate.WildernessMaxRoad, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="Longest gravel road" />
                                                <TextBlock Text="Longest road (m); POIs farther from a road get none" Style="{StaticResource HintText}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Button Content="Game settings" HorizontalAlignment="Left" Margin="0,8,0,0" Click="WildernessDefaults_Click"
                                                    ToolTip="Put back the game's count, mix and roads (keeps the seed)" />
                                        </StackPanel>

                                        <DockPanel Margin="0,12,0,0">
                                            <Button DockPanel.Dock="Left" Content="Generate" Style="{DynamicResource AccentButtonStyle}" MinWidth="100"
                                                    IsEnabled="{Binding Generate.CanEdit}" Click="WildernessGenerate_Click"
                                                    ToolTip="Take out the last run's POIs and roads and place new ones, as one undo step. Placed and pinned ones stay." />
                                            <Button DockPanel.Dock="Left" Content="Remove all" Margin="6,0,0,0" IsEnabled="{Binding Generate.HasWilderness}" Click="WildernessRemove_Click"
                                                    ToolTip="Take out every POI and gravel road this stage placed, pinned ones too, putting back the ground, as one undo step" />
                                            <Border />
                                        </DockPanel>

                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Click="WildernessPlace_Click"
                                                ToolTip="Click empty ground to place a POI there, pinned; click a POI this stage placed to pick it">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{x:Static local:Icons.Prefab}" Style="{StaticResource IconPath}" Width="14" Height="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Place on the map" />
                                            </StackPanel>
                                        </Button>
                                        <DockPanel Margin="0,6,0,0" IsEnabled="{Binding Generate.CanEdit}">
                                            <TextBlock DockPanel.Dock="Left" Text="Place" Style="{StaticResource GenLabel}" />
                                            <ComboBox ItemsSource="{Binding Generate.PoiChoices}" SelectedItem="{Binding Generate.PlacePoi}" IsTextSearchEnabled="True"
                                                      HorizontalAlignment="Stretch" AutomationProperties.Name="POI to place by hand" />
                                        </DockPanel>
                                        <Border Margin="0,8,0,0" Padding="8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                Visibility="{Binding Generate.HasSelectedPoi, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel IsEnabled="{Binding Generate.CanEdit}">
                                                <TextBlock Text="{Binding Generate.SelectedPoiText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <DockPanel Margin="0,6,0,0">
                                                    <Button DockPanel.Dock="Left" Content="Drop" Click="PoiDrop_Click" ToolTip="Take this POI and its gravel road out of the world" />
                                                    <CheckBox Content="Pinned" IsChecked="{Binding Generate.SelectedPoiPinned}" Margin="10,0,0,0" MinWidth="0"
                                                              ToolTip="Keep this POI when the stage is generated again" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Expander>

                                <!-- Stage 6: spawn points (traders come from stage 2's Build). -->
                                <Expander Style="{StaticResource StageExpander}" Margin="0,8,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          IsExpanded="{Binding Generate.OpenStage, Converter={StaticResource StageOpen}, ConverterParameter=6}">
                                    <Expander.Header>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="6  Spawn points" FontWeight="SemiBold" FontSize="15" />
                                                <Border Style="{StaticResource DoneBadge}"
                                                           Visibility="{Binding Generate.SpawnDone, Converter={StaticResource BoolToVisibility}}">
                                                           <TextBlock Text="Done" />
                                                           </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Generate.SpawnStatusLine}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       ToolTip="{Binding Generate.SpawnStatus}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel>

                                        <StackPanel IsEnabled="{Binding Generate.CanEdit}">
                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="Seed" Style="{StaticResource GenLabel}" />
                                                <Button DockPanel.Dock="Right" Content="Re-roll" Margin="6,0,0,0" Click="SpawnsReroll_Click"
                                                        ToolTip="Generate again with a new seed. Spawns you placed or moved stay." />
                                                <TextBox Text="{Binding Generate.SpawnSeed, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Spawn seed" />
                                            </DockPanel>
                                            <Expander Style="{StaticResource LinkExpander}" Header="How the game does it" Margin="0,10,0,4" HorizontalAlignment="Stretch">
                                                <TextBlock Text="The game's way: along stage 5's gravel roads, next to tier 0 and 1 POIs, near a trader of the same biome, 60 m apart; then the free cells nearest a trader until there are enough. Traders come from Build in stage 2."
                                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                            </Expander>
                                            <TextBlock Text="Biomes (the game uses the forest)" Style="{StaticResource HintText}" Margin="0,4,0,2" />
                                            <WrapPanel>
                                                <CheckBox Content="Forest" IsChecked="{Binding Generate.SpawnForest}" MinWidth="0" Margin="0,0,12,0" />
                                                <CheckBox Content="Burnt forest" IsChecked="{Binding Generate.SpawnBurntForest}" MinWidth="0" Margin="0,0,12,0" />
                                                <CheckBox Content="Desert" IsChecked="{Binding Generate.SpawnDesert}" MinWidth="0" Margin="0,0,12,0" />
                                                <CheckBox Content="Snow" IsChecked="{Binding Generate.SpawnSnow}" MinWidth="0" Margin="0,0,12,0" />
                                                <CheckBox Content="Wasteland" IsChecked="{Binding Generate.SpawnWasteland}" MinWidth="0" Margin="0,0,12,0" />
                                            </WrapPanel>
                                            <TextBlock Text="None ticked: any biome, any trader." Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBox DockPanel.Dock="Right" Width="50" Text="{Binding Generate.SpawnMin, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="Fewest spawns" />
                                                <TextBlock Text="At least (the game's is 12; spawns already in the world count)" Style="{StaticResource HintText}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBox DockPanel.Dock="Right" Width="50" Text="{Binding Generate.SpawnMax, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="Most spawns" />
                                                <TextBlock Text="At most (0 for no limit, as the game)" Style="{StaticResource HintText}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="The gravel roads from stage 5 get spawns first, often many more than the least number. Set At most to limit them."
                                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="Stage 5 has no gravel roads yet, so only the least number go in. After stage 5 runs, Generate again for the road spawns."
                                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding Generate.SpawnsWithoutRoads, Converter={StaticResource BoolToVisibility}}" />
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBox DockPanel.Dock="Right" Width="50" Text="{Binding Generate.SpawnTraderDistance, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="Trader distance" />
                                                <TextBlock Text="Trader distance (m): a spawn by a gravel road must be this close to a trader. The game uses 900." Style="{StaticResource HintText}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                                           ToolTip="Only spawns along stage 5's gravel roads are checked. The top-up spawns go in the free cells nearest a trader." />
                                            </DockPanel>
                                            <CheckBox Content="Near the opening quest's trader" IsChecked="{Binding Generate.SpawnNearStarterTrader}" Margin="0,8,0,0"
                                                      ToolTip="The game's first quest sends every new player to one pine-forest trader: the one with the most tier-1 POIs within 500 m, however far away. With this ticked, spawns go within the trader distance of that trader (750 m at most, where Validate starts to warn), and the top-up nearest it. Not ticked: by any trader of their biome, as the game does." />
                                            <Button Content="Game settings" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SpawnsDefaults_Click"
                                                    ToolTip="Put back the game's biome, count and trader distance (keeps the seed)" />
                                        </StackPanel>

                                        <DockPanel Margin="0,12,0,0">
                                            <Button DockPanel.Dock="Left" Content="Generate" Style="{DynamicResource AccentButtonStyle}" MinWidth="100"
                                                    IsEnabled="{Binding Generate.CanEdit}" Click="SpawnsGenerate_Click"
                                                    ToolTip="Take out the last run's spawns and place new ones, as one undo step. Spawns you placed or moved stay." />
                                            <Button DockPanel.Dock="Left" Content="Remove all" Margin="6,0,0,0" IsEnabled="{Binding Generate.HasSpawns}" Click="SpawnsRemove_Click"
                                                    ToolTip="Take out every spawn this stage placed, as one undo step" />
                                            <Border />
                                        </DockPanel>
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Click="SpawnsEdit_Click"
                                                ToolTip="Add, move, turn and delete spawns by hand. A spawn you add or move is yours and stays when the stage runs again.">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{x:Static local:Icons.Spawn}" Style="{StaticResource IconPath}" Width="14" Height="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Edit on the map" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
            <!-- Drag the left edge to widen or narrow the panel. -->
            <Thumb x:Name="SidePanelEdge" HorizontalAlignment="Left" Width="6" Cursor="SizeWE" DragDelta="SidePanelEdge_DragDelta"
                   ToolTip="Drag to resize the side panel" AutomationProperties.Name="Resize side panel">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            </Grid>
        </Border>

        <!-- The map, centred on the canvas backdrop. -->
        <Grid>
            <map:MapView x:Name="Map"
                         Backdrop="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                         Layers="{Binding Layers}"
                         ShowPrefabs="{Binding ShowPrefabs}"
                         ShowPrefabDetail="{Binding ShowPrefabDetail}"
                         ShowSpawns="{Binding ShowSpawns}"
                         ShowWorldGrid="{Binding ShowWorldGrid}"
                         DimMap="{Binding DimMap}"
                         AutomationProperties.Name="Map" />
            <map:PlayerMarkerOverlay x:Name="PlayerOverlay" IsHitTestVisible="False" ClipToBounds="True" />

            <!-- Modern theme (#63): the tool's changing help, over the map so the map never moves. Clicks pass through it. -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12" MaxWidth="640" Padding="12,8" CornerRadius="6" BorderThickness="1"
                    IsHitTestVisible="False" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HintCardText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsModernTheme}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding HintCardText}" Style="{StaticResource HintText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Border>

            <!-- Info card for the prefab selected on the map, or the trader the Trader tool places. -->
            <Border Width="300" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="12" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    Visibility="{Binding ShowPrefabCard, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding CardHeading}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"
                                   Visibility="{Binding ShowCardHeading, Converter={StaticResource BoolToVisibility}}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="✕" Padding="6,0"
                                    Visibility="{Binding CardHasReplace, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Deselect" AutomationProperties.Name="Deselect" Click="PrefabCardClose_Click" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="4,0" Click="CardFavourite_Click"
                                    Visibility="{Binding ShowCardTier, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Favourite (find it under Favourites in the prefab list)" AutomationProperties.Name="Favourite">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource FavouriteStar}">
                                            <Binding Path="CardName" />
                                            <Binding Path="Favourites" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource FavouriteStar}" ConverterParameter="brush">
                                            <Binding Path="CardName" />
                                            <Binding Path="Favourites" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Button>
                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="6,0,4,0" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="{Binding ShowCardTier, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding CardTierText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding CardTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip="{Binding CardName}" />
                        </DockPanel>
                        <TextBlock Text="{Binding CardName}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding ShowCardFileName, Converter={StaticResource BoolToVisibility}}" />
                        <ContentControl Content="{Binding CardPrefab}" Style="{StaticResource PrefabPreview}"
                                        MaxHeight="200" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding CardText}" Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <UniformGrid Columns="4" Margin="0,8,0,0"
                                     Visibility="{Binding ShowCardButtons, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="↺ Q" ToolTip="Turn a quarter counter-clockwise" Margin="0,0,3,0" Padding="2,4" Click="PrefabTurnLeft_Click" />
                            <Button Content="↻ E" ToolTip="Turn a quarter clockwise" Margin="0,0,3,0" Padding="2,4" Click="PrefabTurnRight_Click" />
                            <Button Content="▲ PgUp" IsEnabled="{Binding CardHasActions}" ToolTip="Raise one block (the ground stays)" Margin="0,0,3,0" Padding="2,4" Click="PrefabRaise_Click" />
                            <Button Content="▼ PgDn" IsEnabled="{Binding CardHasActions}" ToolTip="Lower one block (the ground stays)" Padding="2,4" Click="PrefabLower_Click" />
                        </UniformGrid>
                        <Button Margin="0,4,0,0" HorizontalAlignment="Stretch" IsEnabled="{Binding CanReplace}" Click="PrefabReplace_Click"
                                Visibility="{Binding CardHasReplace, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Pick a prefab in the browser, then swap it in here, facing the same way">
                            <TextBlock Text="{Binding ReplaceLabel}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button Content="Delete  (Del)" Margin="0,4,0,0" HorizontalAlignment="Stretch" Click="PrefabDelete_Click"
                                Visibility="{Binding CardHasActions, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource FlatButton}" Margin="0,4,0,0" HorizontalAlignment="Left" Padding="4,2" Click="PrefabCardBack_Click"
                                Visibility="{Binding ShowCardHeading, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Show the prefab on the map again (Esc drops the pick)" AutomationProperties.Name="Back to the map prefab">
                            <TextBlock TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                ← Back to <Run Text="{Binding SelectedMapPrefabName, Mode=OneWay}" />
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <map:MiniMap x:Name="Overview" Width="200" Height="200" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Visibility="{Binding WorldMiniMapVisible, Converter={StaticResource BoolToVisibility}}" />

            <!-- Shown until a world is open. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="StartPanel">
                <TextBlock Text="{x:Static local:App.ProductName}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Make a new world, or open a project or a world folder." Style="{StaticResource HintText}"
                           HorizontalAlignment="Center" Margin="0,6,0,16" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="New World..." Style="{DynamicResource AccentButtonStyle}" Command="{x:Static local:MainWindow.NewWorldCommand}"
                            MinWidth="130" Margin="0,0,8,0" />
                    <Button Content="_Open..." Command="{x:Static local:MainWindow.OpenCommand}" MinWidth="110" Margin="0,0,8,0" />
                    <Button Content="Open World Fol_der..." Command="{x:Static local:MainWindow.OpenWorldCommand}" MinWidth="150" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
