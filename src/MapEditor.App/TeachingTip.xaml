<UserControl x:Class="MapEditor.App.TeachingTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Border x:Name="Card" Width="320" Margin="10" Padding="16" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
            <StackPanel>
                <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Name="Body" Margin="0,8,0,14" TextWrapping="Wrap" />
                <CheckBox x:Name="DontShowAgain" Content="Don't show again" AutomationProperties.Name="Don't show again"
                          Margin="0,0,0,12" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Back" AutomationProperties.Name="Back" Margin="0,0,6,0"
                            Focusable="True" Click="Back_Click" />
                    <Button Content="Close" AutomationProperties.Name="Close" Margin="0,0,6,0"
                            Focusable="True" Click="Close_Click" />
                    <Button x:Name="NextButton" Content="Next" AutomationProperties.Name="Next" Focusable="True"
                            Style="{DynamicResource AccentButtonStyle}" Click="Next_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Canvas IsHitTestVisible="False">
            <Path x:Name="TailFill" Fill="{Binding Background, ElementName=Card}" />
            <Path x:Name="TailStroke" Stroke="{Binding BorderBrush, ElementName=Card}" StrokeThickness="1" />
        </Canvas>
    </Grid>
</UserControl>
