<UserControl x:Class="MapEditor.App.WorldStatsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="StatsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StatsValue" TargetType="TextBlock" BasedOn="{StaticResource StatsLabel}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="StatsSection" TargetType="TextBlock" BasedOn="{StaticResource StatsLabel}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,16,0,5" />
        </Style>
        <Style x:Key="StatsMessage" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ValueRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource StatsLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource StatsValue}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="BiomeRow">
            <StackPanel Margin="0,3,0,4">
                <DockPanel Margin="0,0,0,3">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Percent, StringFormat={}{0:0.0}%}" Style="{StaticResource StatsValue}" />
                    <TextBlock Text="{Binding Label}" Style="{StaticResource StatsLabel}" />
                </DockPanel>
                <Grid Height="6">
                    <Border Background="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.20" />
                    <Rectangle Fill="{Binding Color, Converter={StaticResource RgbToBrush}}"
                               Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1"
                               RenderTransformOrigin="0,0">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Fraction}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding WorldStatsStatus}" Style="{StaticResource StatsMessage}" AutomationProperties.LiveSetting="Polite" />
        <ContentControl Content="{Binding WorldStats}" HorizontalContentAlignment="Stretch">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Style.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource StatsLabel}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Size}" Style="{StaticResource HintText}" Margin="0,2,0,8" />
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Height}" Style="{StaticResource StatsValue}" />
                            <TextBlock Text="Height range" Style="{StaticResource StatsLabel}" />
                        </DockPanel>
                        <Grid Height="8" Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <Rectangle Fill="{DynamicResource SystemFillColorSuccessBrush}" RenderTransformOrigin="0,0">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding LandFraction}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <DockPanel Margin="0,5,0,0">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding LandPercent, StringFormat='Land {0:0.0}%'}" Style="{StaticResource StatsLabel}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding WaterPercent, StringFormat='Water {0:0.0}%'}" Style="{StaticResource StatsLabel}" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="Biomes (% of land)" Style="{StaticResource StatsSection}" />
                        <TextBlock Text="{Binding BiomeStatus}" Style="{StaticResource StatsMessage}" />
                        <ItemsControl ItemsSource="{Binding Biomes}" ItemTemplate="{StaticResource BiomeRow}" />

                        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" />
                        <TextBlock Text="Road length (estimate)" Style="{StaticResource StatsSection}"
                                   ToolTip="The estimate uses the area covered by each road surface." />
                        <ItemsControl ItemsSource="{Binding Roads}" ItemTemplate="{StaticResource ValueRow}" />

                        <TextBlock Text="Placed features" Style="{StaticResource StatsSection}" />
                        <ItemsControl ItemsSource="{Binding Placements}" ItemTemplate="{StaticResource ValueRow}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PoisByTier.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="POIs by tier" Style="{StaticResource HintText}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding PoisByTier}" ItemTemplate="{StaticResource ValueRow}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="POIs by biome" Style="{StaticResource HintText}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding PoisByBiome}" ItemTemplate="{StaticResource ValueRow}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource StatsLabel}" Margin="0,4,0,0"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander Header="World files" Margin="0,8,0,0" Style="{StaticResource LinkExpander}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <StackPanel Margin="0,4,0,0">
                                <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource ValueRow}" />
                                <TextBlock Text="{Binding ExtraFiles}" Style="{StaticResource StatsMessage}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </StackPanel>
</UserControl>
