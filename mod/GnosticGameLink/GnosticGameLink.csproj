<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Version>1.1.0</Version>
    <Authors>Gnostic</Authors>
    <Product>Gnostic Game Link</Product>
    <ManagedDirectory>$(GamePath)\7DaysToDie_Data\Managed</ManagedDirectory>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\MapEditor.Core\GameLink\GameLinkProtocol.cs" Link="GameLinkProtocol.cs" />
    <Compile Include="..\..\src\MapEditor.Core\GameLink\GameLinkOpenRequest.cs" Link="GameLinkOpenRequest.cs" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDirectory)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(ManagedDirectory)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="LogLibrary" HintPath="$(ManagedDirectory)\LogLibrary.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagedDirectory)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDirectory)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(ManagedDirectory)\UnityEngine.ImageConversionModule.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGamePath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GamePath)' == '' Or !Exists('$(ManagedDirectory)\Assembly-CSharp.dll')"
           Text="Set GamePath to the 7 Days To Die install folder with build.ps1." />
  </Target>
</Project>
